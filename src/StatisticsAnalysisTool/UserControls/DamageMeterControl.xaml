<UserControl x:Class="StatisticsAnalysisTool.UserControls.DamageMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:damageMeter="clr-namespace:StatisticsAnalysisTool.DamageMeter"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="YourStats.Damage.CardBackground" Color="{StaticResource Color.Accent.Red.6}" Opacity="0.14" />
        <SolidColorBrush x:Key="YourStats.Damage.MetricBackground" Color="{StaticResource Color.Accent.Red.5}" Opacity="0.2" />
        <SolidColorBrush x:Key="YourStats.Healing.CardBackground" Color="{StaticResource Color.Accent.Green.6}" Opacity="0.14" />
        <SolidColorBrush x:Key="YourStats.Healing.MetricBackground" Color="{StaticResource Color.Accent.Green.5}" Opacity="0.2" />
        <SolidColorBrush x:Key="YourStats.Defense.CardBackground" Color="{StaticResource Color.Accent.Blue.5}" Opacity="0.14" />
        <SolidColorBrush x:Key="YourStats.Defense.MetricBackground" Color="{StaticResource Color.Accent.Blue.4}" Opacity="0.2" />
        <SolidColorBrush x:Key="YourStats.Combat.CardBackground" Color="{StaticResource Color.Accent.Yellow.5}" Opacity="0.14" />
        <SolidColorBrush x:Key="YourStats.Combat.MetricBackground" Color="{StaticResource Color.Accent.Yellow.4}" Opacity="0.2" />
        <Style x:Key="YourStats.SectionCard" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="YourStats.MetricCard" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="YourStats.Damage.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.MetricCard}">
            <Setter Property="Background" Value="{StaticResource YourStats.Damage.MetricBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.6}" />
        </Style>
        <Style x:Key="YourStats.Healing.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.MetricCard}">
            <Setter Property="Background" Value="{StaticResource YourStats.Healing.MetricBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Green.6}" />
        </Style>
        <Style x:Key="YourStats.Defense.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.MetricCard}">
            <Setter Property="Background" Value="{StaticResource YourStats.Defense.MetricBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.5}" />
        </Style>
        <Style x:Key="YourStats.Combat.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.MetricCard}">
            <Setter Property="Background" Value="{StaticResource YourStats.Combat.MetricBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Yellow.5}" />
        </Style>
        <Style x:Key="YourStats.HeaderIcon" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="YourStats.SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="YourStats.MetricLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.3}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="YourStats.MetricValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <DataTemplate x:Key="DamageStatsEntryTemplate" DataType="{x:Type damageMeter:DamageStatsEntry}">
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Foreground="{StaticResource SolidColorBrush.Text.2}" FontSize="18" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding PlayerName}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="14" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding ValueString}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" HorizontalAlignment="Right" FontSize="15" FontWeight="Bold" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="YourStatsTopEntryTemplate" DataType="{x:Type damageMeter:DamageMeterYourStatsTopEntry}">
            <Border Margin="2,1" Padding="6,3" Background="{StaticResource YourStats.Defense.MetricBackground}"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.5}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Foreground="{StaticResource SolidColorBrush.Text.2}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueString}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="YourStatsHealingTopEntryTemplate" DataType="{x:Type damageMeter:DamageMeterYourStatsTopEntry}">
            <Border Margin="2,1" Padding="6,3" Background="{StaticResource YourStats.Healing.MetricBackground}"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Green.6}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Foreground="{StaticResource SolidColorBrush.Text.2}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueString}" Foreground="{StaticResource SolidColorBrush.Accent.Green.3}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="YourStatsSnapshotTemplate" DataType="{x:Type damageMeter:DamageMeterYourStatsSnapshot}">
            <ScrollViewer Margin="0,5,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                <Grid Margin="4,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Margin="0,2,5,5"
                            Style="{StaticResource YourStats.SectionCard}"
                            Background="{StaticResource YourStats.Damage.CardBackground}"
                            BorderBrush="{StaticResource SolidColorBrush.Accent.Red.6}">
                        <StackPanel>
                            <Grid Margin="2,0,2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource YourStats.HeaderIcon}"
                                        Background="{StaticResource YourStats.Damage.MetricBackground}"
                                        BorderBrush="{StaticResource SolidColorBrush.Accent.Red.6}">
                                    <fa5:ImageAwesome Icon="Solid_FistRaised" Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DataContext.DamageMeterBindings.TranslationYourStatsDamageSection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=YOUR_STATS_DAMAGE_SECTION}"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Red.2}"
                                           Style="{StaticResource YourStats.SectionTitle}" />
                            </Grid>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource YourStats.Damage.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTotalDamage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=TOTAL_DAMAGE}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding TotalDamage}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Damage.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTotalDps, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=TOTAL_DPS}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding TotalDps}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Damage.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPeakDpsFiveSeconds, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=PEAK_DPS_5_SECONDS}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding PeakDpsFiveSeconds}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Columns="5">
                                <Border Style="{StaticResource YourStats.Damage.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPeakDpsThreeSeconds, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=PEAK_DPS_3_SECONDS}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding PeakDpsThreeSeconds}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Damage.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPeakDpsTenSeconds, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=PEAK_DPS_10_SECONDS}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding PeakDpsTenSeconds}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Damage.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationBiggestHit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=BIGGEST_HIT}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding BiggestHit}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Damage.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPveDamage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=PVE_DAMAGE}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding PveDamage}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Damage.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPvpDamage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=PVP_DAMAGE}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding PvpDamage}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Margin="5,2,0,5"
                            Style="{StaticResource YourStats.SectionCard}"
                            Background="{StaticResource YourStats.Healing.CardBackground}"
                            BorderBrush="{StaticResource SolidColorBrush.Accent.Green.6}">
                        <StackPanel>
                            <Grid Margin="2,0,2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource YourStats.HeaderIcon}"
                                        Background="{StaticResource YourStats.Healing.MetricBackground}"
                                        BorderBrush="{StaticResource SolidColorBrush.Accent.Green.6}">
                                    <fa5:ImageAwesome Icon="Regular_Heart" Foreground="{StaticResource SolidColorBrush.Accent.Green.3}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DataContext.DamageMeterBindings.TranslationYourStatsHealingSection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=YOUR_STATS_HEALING_SECTION}"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"
                                           Style="{StaticResource YourStats.SectionTitle}" />
                            </Grid>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource YourStats.Healing.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTotalHealing, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=TOTAL_HEALING}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding TotalHealing}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Healing.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationEffectiveHealing, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=EFFECTIVE_HEALING}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding EffectiveHealing}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Healing.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationOverhealPercent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=OVERHEAL_PERCENT}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding OverhealPercent}" Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"
                                                   Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationHealingTargetsTopThree, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=HEALING_TARGETS_TOP_3}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Green.1}"
                                       FontSize="12" FontWeight="Bold" Margin="2,8,2,3" />
                            <ItemsControl ItemsSource="{Binding TopHealingTargets}" ItemTemplate="{StaticResource YourStatsHealingTopEntryTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Margin="0,5,5,2"
                            Style="{StaticResource YourStats.SectionCard}"
                            Background="{StaticResource YourStats.Defense.CardBackground}"
                            BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.5}">
                        <StackPanel>
                            <Grid Margin="2,0,2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource YourStats.HeaderIcon}"
                                        Background="{StaticResource YourStats.Defense.MetricBackground}"
                                        BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.5}">
                                    <fa5:ImageAwesome Icon="Solid_ShieldAlt" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DataContext.DamageMeterBindings.TranslationYourStatsDefenseSection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=YOUR_STATS_DEFENSE_SECTION}"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                           Style="{StaticResource YourStats.SectionTitle}" />
                            </Grid>
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource YourStats.Defense.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationDamageTaken, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=DAMAGE_TAKEN}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding DamageTaken}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Defense.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationDtps, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=DTPS}"
                                                   ToolTip="{Binding DataContext.DamageMeterBindings.TranslationDtpsTooltip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=DTPS_TOOLTIP}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding Dtps}"
                                                   ToolTip="{Binding DataContext.DamageMeterBindings.TranslationDtpsTooltip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=DTPS_TOOLTIP}"
                                                   Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationBiggestDamageTakenBySpellTopThree, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=BIGGEST_DAMAGE_TAKEN_BY_SPELL_TOP_3}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Blue.1}"
                                       FontSize="12" FontWeight="Bold" Margin="2,8,2,3" />
                            <ItemsControl ItemsSource="{Binding TopDamageTakenBySpell}" ItemTemplate="{StaticResource YourStatsTopEntryTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Margin="5,5,0,2"
                            Style="{StaticResource YourStats.SectionCard}"
                            Background="{StaticResource YourStats.Combat.CardBackground}"
                            BorderBrush="{StaticResource SolidColorBrush.Accent.Yellow.5}">
                        <StackPanel>
                            <Grid Margin="2,0,2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource YourStats.HeaderIcon}"
                                        Background="{StaticResource YourStats.Combat.MetricBackground}"
                                        BorderBrush="{StaticResource SolidColorBrush.Accent.Yellow.5}">
                                    <fa5:ImageAwesome Icon="Regular_Clock" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.3}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DataContext.DamageMeterBindings.TranslationYourStatsCombatSection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=YOUR_STATS_COMBAT_SECTION}"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Yellow.3}"
                                           Style="{StaticResource YourStats.SectionTitle}" />
                            </Grid>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource YourStats.Combat.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationCombatTime, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=COMBAT_TIME}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding CombatTime}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Combat.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationFightCount, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=FIGHT_COUNT}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding FightCount}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource YourStats.Combat.MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationAverageFightDuration, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=AVERAGE_FIGHT_DURATION}"
                                                   Style="{StaticResource YourStats.MetricLabel}" />
                                        <TextBlock Text="{Binding AverageFightDuration}" Style="{StaticResource YourStats.MetricValue}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate x:Key="DamageStatsSnapshotTemplate" DataType="{x:Type damageMeter:DamageStatsSnapshot}">
            <ScrollViewer Margin="0,5,0,0">
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <Border Margin="0,2,10,0" Padding="5" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.DamageMeterBindings.TranslationBiggestSingleHitTop5, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=BIGGEST_SINGLE_HIT_TOP_5}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Red.1}" FontWeight="Bold" Margin="0,0,0,2" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TopSingleHits}" ItemTemplate="{StaticResource DamageStatsEntryTemplate}" Foreground="{StaticResource SolidColorBrush.Accent.Red.1}" />
                        </DockPanel>
                    </Border>
                    <Border Margin="10,2,0,0" Padding="5" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.DamageMeterBindings.TranslationBiggestSingleHealTop5, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=BIGGEST_SINGLE_HEAL_TOP_5}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Green.2}" FontWeight="Bold" Margin="0,0,0,2" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TopSingleHeals}" ItemTemplate="{StaticResource DamageStatsEntryTemplate}" Foreground="{StaticResource SolidColorBrush.Accent.Green.2}" />
                        </DockPanel>
                    </Border>
                    <Border Margin="0,2,10,0" Padding="5" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.DamageMeterBindings.TranslationLastHitsTop5, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=LAST_HITS_TOP_5}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" FontWeight="Bold" Margin="0,0,0,2" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TopLastHits}" ItemTemplate="{StaticResource DamageStatsEntryTemplate}" Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" />
                        </DockPanel>
                    </Border>
                    <Border Margin="10,2,0,0" Padding="5" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.DamageMeterBindings.TranslationOverhealTop5, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=OVERHEAL_TOP_5}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Green.5}" FontWeight="Bold" Margin="0,0,0,2" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TopOverheals}" ItemTemplate="{StaticResource DamageStatsEntryTemplate}" Foreground="{StaticResource SolidColorBrush.Accent.Green.5}" />
                        </DockPanel>
                    </Border>
                    <Border Margin="0,2,10,0" Padding="5" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.DamageMeterBindings.TranslationDamageTakenTop5, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=DAMAGE_TAKEN_TOP_5}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Red.5}" FontWeight="Bold" Margin="0,0,0,2" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TopTakenDamage}" ItemTemplate="{StaticResource DamageStatsEntryTemplate}" Foreground="{StaticResource SolidColorBrush.Accent.Red.5}" />
                        </DockPanel>
                    </Border>
                    <Border Margin="10,2,0,0" Padding="5" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.DamageMeterBindings.TranslationBurstDamageFiveSecondsTop5, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=BURST_DAMAGE_5_SECONDS_TOP_5}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" FontWeight="Bold" Margin="0,0,0,2" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TopBurstDamageFiveSeconds}" ItemTemplate="{StaticResource DamageStatsEntryTemplate}" Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" />
                        </DockPanel>
                    </Border>
                    <Border Margin="0,2,10,0" Padding="5" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.DamageMeterBindings.TranslationBurstDamageTenSecondsTop5, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=BURST_DAMAGE_10_SECONDS_TOP_5}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" FontWeight="Bold" Margin="0,0,0,2" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TopBurstDamageTenSeconds}" ItemTemplate="{StaticResource DamageStatsEntryTemplate}" Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" />
                        </DockPanel>
                    </Border>
                    <Border Margin="10,2,0,0" Padding="5" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.DamageMeterBindings.TranslationAttackedMobsPlayersTop5, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=ATTACKED_MOBS_PLAYERS_TOP_5}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" FontWeight="Bold" Margin="0,0,0,2" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TopAttackedTargets}" ItemTemplate="{StaticResource DamageStatsEntryTemplate}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                        </DockPanel>
                    </Border>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding DamageMeterBindings.TranslationLive, FallbackValue=LIVE}">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="{Binding DamageMeterBindings.TranslationMeter, FallbackValue=METER}">
                        <Grid Margin="10,10,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Style="{StaticResource App.TopFilterCard}"
                                    Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource App.FilterGroup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.Status, FallbackValue=STATUS}"
                                                       Style="{StaticResource App.FilterLabel}" />
                                            <Button MinWidth="190"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource Style.Button.Neutral}"
                                                    ToolTip="{Binding Translation.DamageMeterOnOff, FallbackValue=DAMAGE__METER__ON__OFF}"
                                                    Click="DamageMeterActivationToggle_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <fa5:ImageAwesome Width="16"
                                                                      Height="16"
                                                                      Margin="0,0,8,0"
                                                                      Icon="{Binding DamageMeterBindings.DamageMeterActivationToggleIcon, FallbackValue=Solid_ToggleOff}"
                                                                      Foreground="{Binding DamageMeterBindings.DamageMeterActivationToggleColor, FallbackValue={StaticResource SolidColorBrush.Text.1}}"
                                                                      IsHitTestVisible="False" />
                                                    <TextBlock VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Text"
                                                                        Value="{Binding Translation.TrackingIsNotActive, FallbackValue=TRACKING__IS__NOT__ACTIVE}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDamageMeterTrackingActive}" Value="True">
                                                                        <Setter Property="Text"
                                                                                Value="{Binding Translation.TrackingIsActive, FallbackValue=TRACKING__IS__ACTIVE}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource App.FilterGroup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.Display, FallbackValue=DISPLAY}"
                                                       Style="{StaticResource App.FilterLabel}" />
                                            <ComboBox Width="210"
                                                      ItemsSource="{Binding DamageMeterBindings.DamageMeterSort}"
                                                      SelectedItem="{Binding DamageMeterBindings.DamageMeterSortSelection}"
                                                      IsSynchronizedWithCurrentItem="True"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="DamageMeterSortType" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource App.FilterGroup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DamageMeterBindings.TranslationContent, FallbackValue=CONTENT}"
                                                       Style="{StaticResource App.FilterLabel}" />
                                            <ComboBox Width="210"
                                                      ItemsSource="{Binding DamageMeterBindings.DamageMeterContentFilters}"
                                                      SelectedItem="{Binding DamageMeterBindings.DamageMeterContentFilterSelection, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                        <Button Style="{StaticResource DamageMeter.ActionButton}"
                                                ToolTip="{Binding Translation.OpenExtendedDamageMeterWindow, FallbackValue=OPEN__EXTENDED__DAMAGE__METER__WINDOW}"
                                                Click="OpenDamageMeterWindow_Click">
                                            <fa5:ImageAwesome Icon="Solid_Expand" Style="{StaticResource DamageMeter.ActionIcon}" />
                                        </Button>
                                        <Button Style="{StaticResource DamageMeter.ActionButton}"
                                                ToolTip="{Binding Translation.CopyToClipboard, FallbackValue=COPY__TO__CLIPBOARD}"
                                                Click="CopyDamageMeterToClipboard_Click">
                                            <fa5:ImageAwesome Icon="Regular_Copy" Style="{StaticResource DamageMeter.ActionIcon}" />
                                        </Button>
                                        <Button Style="{StaticResource DamageMeter.ActionButton}"
                                                ToolTip="{Binding DamageMeterBindings.TranslationTakeASnapshotOfDamageMeterDescription, FallbackValue=TAKE_A_SNAPSHOT_OF_DAMAGE_METER}"
                                                Click="TakeSnapshot_Click">
                                            <fa5:ImageAwesome Icon="Solid_Camera" Style="{StaticResource DamageMeter.ActionIcon}" />
                                        </Button>
                                        <Button Style="{StaticResource DamageMeter.ActionButton}"
                                                ToolTip="{Binding Translation.DamageMeter, FallbackValue=DAMAGE__METER}"
                                                MouseEnter="OpenDamageMeterInfoPopup_MouseEnter"
                                                MouseLeave="CloseDamageMeterInfoPopup_MouseLeave">
                                            <fa5:ImageAwesome Icon="Solid_InfoCircle" Style="{StaticResource DamageMeter.ActionIcon}" />
                                        </Button>
                                        <Button Content="{Binding Translation.ResetDamageMeter, FallbackValue=RESET__DAMAGE__METER}"
                                                Margin="2,0,0,0"
                                                Style="{StaticResource DamageMeter.DangerButton}"
                                                Click="ResetDamageMeter_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="2" Margin="-3,0,0,0">
                                <ScrollViewer.Style>
                                    <Style TargetType="{x:Type ScrollViewer}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DamageMeterBindings.DamageMeterSortSelection.DamageMeterSortType}"
                                                         Value="{x:Static damageMeter:DamageMeterSortType.Mob}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding DamageMeterBindings.DamageMeter, IsAsync=True, Mode=OneWay}"
                                              ItemTemplate="{StaticResource DamageMeterFragmentTemplate}" />
                            </ScrollViewer>
                            <ScrollViewer Grid.Row="2" Margin="-3,0,0,0"
                                          HorizontalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="{x:Type ScrollViewer}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DamageMeterBindings.DamageMeterSortSelection.DamageMeterSortType}"
                                                         Value="{x:Static damageMeter:DamageMeterSortType.Mob}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding DamageMeterBindings.MobDamageMeter, IsAsync=True, Mode=OneWay}"
                                              ItemTemplate="{StaticResource MobDamageMeterFragmentTemplate}" />
                            </ScrollViewer>

                            <Grid Grid.Row="2"
                                  Panel.ZIndex="1"
                                  Visibility="{Binding IsDamageMeterPopupVisible, FallbackValue=Hidden}"
                                  Background="{StaticResource SolidColorBrush.Background.2}">
                                <StackPanel CanHorizontallyScroll="False"
                                            CanVerticallyScroll="True"
                                            Margin="14,12">
                                    <DockPanel Margin="0,0,0,16">
                                        <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                                            <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Translation.DamageMeterDescription1}"
                                                   Foreground="{StaticResource SolidColorBrush.Text.1}"
                                                   FontSize="16"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,16">
                                        <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                                            <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Translation.DamageMeterDescription2}"
                                                   Foreground="{StaticResource SolidColorBrush.Text.1}"
                                                   FontSize="16"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding DamageMeterBindings.TranslationTopStats, FallbackValue=TOP_STATS}">
                        <ContentControl Content="{Binding DamageMeterBindings.CurrentDamageStats}"
                                        ContentTemplate="{StaticResource DamageStatsSnapshotTemplate}" />
                    </TabItem>
                    <TabItem Header="{Binding DamageMeterBindings.TranslationYourStats, FallbackValue=YOUR_STATS}">
                        <ContentControl Content="{Binding DamageMeterBindings.CurrentYourStats}"
                                        ContentTemplate="{StaticResource YourStatsSnapshotTemplate}" />
                    </TabItem>

                    <TabItem Header="{Binding Translation.Settings, FallbackValue=SETTINGS}">
                        <ScrollViewer Padding="10,10,12,0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">
                            <Border Style="{StaticResource Settings.Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource Settings.CardHeader}">
                                        <TextBlock Text="{Binding Translation.Settings, FallbackValue=SETTINGS}"
                               Style="{StaticResource Settings.CardTitle}" />
                                    </Border>

                                    <Grid Margin="14,12,14,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <CheckBox IsChecked="{Binding DamageMeterBindings.IsDamageMeterResetByMapChangeActive}"
                                  Style="{StaticResource DamageMeter.SettingCheckBox}">
                                                <TextBlock Text="{Binding Translation.MapChangeReset, FallbackValue=MAP__CHANGE__RESET}"
                                       TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding DamageMeterBindings.IsDamageMeterResetBeforeCombatActive}"
                                  Style="{StaticResource DamageMeter.SettingCheckBox}">
                                                <TextBlock Text="{Binding Translation.ResetBeforeCombat, FallbackValue=RESET__BEFORE__COMBAT}"
                                       TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding DamageMeterBindings.IsSnapshotAfterMapChangeActive}"
                                  Style="{StaticResource DamageMeter.SettingCheckBox}">
                                                <TextBlock Text="{Binding Translation.SnapshotAfterMapChange, FallbackValue=SNAPSHOT__AFTER__MAP__CHANGE}"
                                       TextWrapping="Wrap" />
                                            </CheckBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <CheckBox IsChecked="{Binding DamageMeterBindings.ShortDamageMeterToClipboard}"
                                  Style="{StaticResource DamageMeter.SettingCheckBox}">
                                                <TextBlock Text="{Binding Translation.CopyShortDamageMeterToTheClipboard, FallbackValue=COPY__SHORT__DAMAGE__METER__TO__THE__CLIPBOARD}"
                                       TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding DamageMeterBindings.OnlyDamageToPlayersCounts}"
                                  Style="{StaticResource DamageMeter.SettingCheckBox}">
                                                <TextBlock Text="{Binding Translation.OnlyDamageToPlayersCounts, FallbackValue=ONLY__DAMAGE__TO__PLAYERS__COUNTS}"
                                       TextWrapping="Wrap" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="{Binding DamageMeterBindings.TranslationSnapshots, FallbackValue=SNAPSHOTS}">
                <Grid Margin="10,10,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource App.TopFilterCard}"
                            Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DamageMeterBindings.TranslationSnapshots, FallbackValue=SNAPSHOTS}"
                                               Style="{StaticResource App.FilterLabel}" />
                                    <ComboBox Width="240"
                                              ItemsSource="{Binding DamageMeterBindings.DamageMeterSnapshots}"
                                              SelectedItem="{Binding DamageMeterBindings.DamageMeterSnapshotSelection}"
                                              IsSynchronizedWithCurrentItem="True"
                                              DisplayMemberPath="TimestampString"
                                              SelectedValuePath="DamageMeter" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource App.FilterGroup}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding DamageMeterBindings.TranslationContent, FallbackValue=CONTENT}"
                                               Style="{StaticResource App.FilterLabel}" />
                                    <ComboBox Width="210"
                                              ItemsSource="{Binding DamageMeterBindings.DamageMeterContentFilters}"
                                              SelectedItem="{Binding DamageMeterBindings.DamageMeterSnapshotContentFilterSelection, Mode=TwoWay}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Grid.Column="3"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom">
                                <Button Content="{Binding DamageMeterBindings.TranslationDeleteSelectedSnapshot, FallbackValue=DELETE__SELECTED__SNAPSHOT}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource DamageMeter.DangerButton}"
                                        Click="DeleteSelectedSnapshot_Click" />
                                <Button Content="{Binding DamageMeterBindings.TranslationDeleteAllSnapshots, FallbackValue=DELETE__ALL__SNAPSHOTS}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource DamageMeter.DangerButton}"
                                        Click="DeleteAllSnapshots_Click" />
                                <Button Style="{StaticResource DamageMeter.TextButton}"
                                        ToolTip="{Binding Translation.CopyToClipboard, FallbackValue=COPY__TO__CLIPBOARD}"
                                        Click="CopySnapshotToClipboard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa5:ImageAwesome Icon="Regular_Copy"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Style="{StaticResource Style.Button.Icon.White}" />
                                        <TextBlock Text="{Binding Translation.CopyToClipboard, FallbackValue=COPY__TO__CLIPBOARD}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                        <TabItem Header="{Binding DamageMeterBindings.TranslationMeter, FallbackValue=METER}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource App.TopFilterCard}"
                                        Margin="0">
                                    <Grid>
                                        <Border HorizontalAlignment="Left"
                                                Style="{StaticResource App.FilterGroup}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Translation.Display, FallbackValue=DISPLAY}"
                                                           Style="{StaticResource App.FilterLabel}" />
                                                <ComboBox Width="210"
                                                          ItemsSource="{Binding DamageMeterBindings.DamageMeterSnapshotSort}"
                                                          SelectedItem="{Binding DamageMeterBindings.DamageMeterSnapshotSortSelection}"
                                                          IsSynchronizedWithCurrentItem="True"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="DamageMeterSortType" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="2" Margin="-3,0,0,0">
                                    <ScrollViewer.Style>
                                        <Style TargetType="{x:Type ScrollViewer}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DamageMeterBindings.DamageMeterSnapshotSortSelection.DamageMeterSortType}"
                                                             Value="{x:Static damageMeter:DamageMeterSortType.Mob}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <ItemsControl ItemsSource="{Binding DamageMeterBindings.DamageMeterSnapshotSelection.DamageMeter, IsAsync=True, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource DamageMeterSnapshotFragmentTemplate}" />
                                </ScrollViewer>
                                <ScrollViewer Grid.Row="2" Margin="-3,0,0,0"
                                              HorizontalScrollBarVisibility="Auto">
                                    <ScrollViewer.Style>
                                        <Style TargetType="{x:Type ScrollViewer}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DamageMeterBindings.DamageMeterSnapshotSortSelection.DamageMeterSortType}"
                                                             Value="{x:Static damageMeter:DamageMeterSortType.Mob}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <ItemsControl ItemsSource="{Binding DamageMeterBindings.DamageMeterSnapshotSelection.MobDamageMeter, IsAsync=True, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource MobDamageMeterFragmentTemplate}" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{Binding DamageMeterBindings.TranslationTopStats, FallbackValue=TOP_STATS}">
                            <ContentControl Content="{Binding DamageMeterBindings.SnapshotDamageStats}"
                                            ContentTemplate="{StaticResource DamageStatsSnapshotTemplate}" />
                        </TabItem>
                        <TabItem Header="{Binding DamageMeterBindings.TranslationYourStats, FallbackValue=YOUR_STATS}">
                            <ContentControl Content="{Binding DamageMeterBindings.SnapshotYourStats}"
                                            ContentTemplate="{StaticResource YourStatsSnapshotTemplate}" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
