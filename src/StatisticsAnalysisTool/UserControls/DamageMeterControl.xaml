                                                                        <Setter Property="Text"
                                                                                Value="{Binding Translation.TrackingIsActive, FallbackValue=TRACKING__IS__ACTIVE}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
