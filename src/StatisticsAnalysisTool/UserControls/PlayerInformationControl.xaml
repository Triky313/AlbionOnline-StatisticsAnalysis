<UserControl x:Class="StatisticsAnalysisTool.UserControls.PlayerInformationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="PlayerInformation.ProfileTemplate" DataType="{x:Type models:PlayerModeInformationModel}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,0,8,12"
                            Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource PlayerInformation.HeroCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="132" Height="132" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border CornerRadius="70" Background="{StaticResource SolidColorBrush.Background.3}" ToolTip="{Binding GameInfoPlayers.AvatarRing}">
                                    <Grid>
                                        <fa5:ImageAwesome Icon="Regular_Image" Width="46" Height="46" Foreground="{StaticResource SolidColorBrush.Text.6}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Margin="4" ToolTip="{Binding GameInfoPlayers.Avatar}">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarImageUrl}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                                <Image Source="{Binding AvatarRingImageUrl}" Width="132" Height="132" Stretch="Uniform"
                                       ToolTip="{Binding GameInfoPlayers.AvatarRing}" IsHitTestVisible="False" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,22,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameInfoPlayers.Name}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding GameInfoPlayers.Id}" Foreground="{StaticResource SolidColorBrush.Text.5}"
                                           FontSize="11" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.GuildName, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=GUILD}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding GameInfoPlayers.GuildName, TargetNullValue='-'}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.AllianceName, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=ALLIANCE}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GameInfoPlayers.AllianceName, TargetNullValue='-'}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" MinWidth="210" VerticalAlignment="Center">
                                <Border Style="{StaticResource PlayerInformation.ApiBadge}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <fa5:ImageAwesome Icon="Solid_InfoCircle" Width="14" Height="14" Margin="0,0,7,0" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                            <TextBlock Text="API" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.DataFromAlbionOnlineServers, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue='Data from Albion Online servers'}"
                                                   Foreground="{StaticResource SolidColorBrush.Text.3}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"> 
                                    <fa5:ImageAwesome Icon="Solid_GlobeEurope" Width="14" Height="14" Margin="0,0,7,0" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                    <TextBlock Text="{Binding ServerName}" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <UniformGrid Columns="5" Margin="-4,4,-4,4">
                        <Border Style="{StaticResource PlayerInformation.MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="1"
                                       Source="../Resources/fame.png"
                                       Style="{StaticResource PlayerInformation.MetricImage}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.KillFame, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=KILL_FAME}"
                                           Style="{StaticResource PlayerInformation.MetricTitle}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding GameInfoPlayers.KillFame, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                           Style="{StaticResource PlayerInformation.MetricValue}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PlayerInformation.MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="1"
                                       Source="../Resources/fame.png"
                                       Style="{StaticResource PlayerInformation.MetricImage}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.DeathFame, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=DEATH_FAME}"
                                           Style="{StaticResource PlayerInformation.MetricTitle}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding GameInfoPlayers.DeathFame, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                           Style="{StaticResource PlayerInformation.MetricValue}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PlayerInformation.MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="1"
                                       Source="../Resources/fame.png"
                                       Style="{StaticResource PlayerInformation.MetricImage}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Pve, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=PVE}"
                                           Style="{StaticResource PlayerInformation.MetricTitle}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding GameInfoPlayers.LifetimeStatistics.PvE.Total, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, TargetNullValue=0}"
                                           Style="{StaticResource PlayerInformation.MetricValue}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PlayerInformation.MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="1"
                                       Source="../Assets/pickaxe.png"
                                       Style="{StaticResource PlayerInformation.MetricImage}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Gathering, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=GATHERING}"
                                           Style="{StaticResource PlayerInformation.MetricTitle}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.All.Total, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, TargetNullValue=0}"
                                           Style="{StaticResource PlayerInformation.MetricValue}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PlayerInformation.MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <fa5:ImageAwesome Grid.Row="1"
                                                  Icon="Solid_Users"
                                                  Width="21"
                                                  Height="21"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.CrystalLeague, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=CRYSTAL_LEAGUE}"
                                           Style="{StaticResource PlayerInformation.MetricTitle}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding GameInfoPlayers.LifetimeStatistics.CrystalLeague, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, TargetNullValue=0}"
                                           Style="{StaticResource PlayerInformation.MetricValue}" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                    <Grid Margin="-4,4,-4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PlayerInformation.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <fa5:ImageAwesome Icon="Solid_Bolt" Width="15" Height="15" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Accent.Red.1}" />
                                    <TextBlock Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Pvp, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=PVP}"
                                               Style="{StaticResource PlayerInformation.SectionTitle}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.KillFame, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=KILL_FAME}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding GameInfoPlayers.KillFame, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.DeathFame, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=DEATH_FAME}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding GameInfoPlayers.DeathFame, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.FameRatio, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=FAME_RATIO}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding GameInfoPlayers.FameRatio, StringFormat={}{0:N2}}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.TotalKills, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=TOTAL_KILLS}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding SearchPlayer.TotalKills, StringFormat={}{0:N0}, TargetNullValue=0}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.GvgKills, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=GVG_KILLS}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="{Binding SearchPlayer.GvgKills, StringFormat={}{0:N0}, TargetNullValue=0}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.GvgWon, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=GVG_WON}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1"
                                               Text="{Binding SearchPlayer.GvgWon, StringFormat={}{0:N0}, TargetNullValue=0}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource PlayerInformation.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <fa5:ImageAwesome Icon="Solid_ShieldAlt" Width="15" Height="15" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
                                    <TextBlock Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Pve, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=PVE}"
                                               Style="{StaticResource PlayerInformation.SectionTitle}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Royal, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=ROYAL}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding GameInfoPlayers.LifetimeStatistics.PvE.Royal, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Outlands, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=OUTLANDS}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding GameInfoPlayers.LifetimeStatistics.PvE.Outlands, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Hellgate, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=HELLGATE}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding GameInfoPlayers.LifetimeStatistics.PvE.Hellgate, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Total, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=TOTAL}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding GameInfoPlayers.LifetimeStatistics.PvE.Total, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                               Style="{StaticResource PlayerInformation.DetailValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="-4,0,-4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PlayerInformation.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <fa5:ImageAwesome Icon="Solid_ChartLine" Width="15" Height="15" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Accent.Green.1}" />
                                    <TextBlock Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Gathering, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=GATHERING}"
                                               Style="{StaticResource PlayerInformation.SectionTitle}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Royal, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=ROYAL}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}"
                                               TextAlignment="Right" />
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Outlands, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=OUTLANDS}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}"
                                               TextAlignment="Right" />
                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Total, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=TOTAL}"
                                               Style="{StaticResource PlayerInformation.DetailLabel}"
                                               TextAlignment="Right" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Fiber, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=FIBER}" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Fiber.Royal, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Fiber.Outlands, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Fiber.Total, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Hide, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=HIDE}" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Hide.Royal, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Hide.Outlands, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Hide.Total, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Ore, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=ORE}" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Ore.Royal, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Ore.Outlands, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Ore.Total, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />

                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Rock, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=ROCK}" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Rock.Royal, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Rock.Outlands, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Rock.Total, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />

                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Wood, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=WOOD}" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Wood.Royal, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Wood.Outlands, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding GameInfoPlayers.LifetimeStatistics.Gathering.Wood.Total, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Style="{StaticResource PlayerInformation.DetailValue}" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource PlayerInformation.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <fa5:ImageAwesome Icon="Solid_Database" Width="15" Height="15" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                    <TextBlock Text="API" Style="{StaticResource PlayerInformation.SectionTitle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.DataFromAlbionOnlineServers, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue='Data from Albion Online servers'}"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Avatar" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding GameInfoPlayers.Avatar, TargetNullValue='-'}" Style="{StaticResource PlayerInformation.DetailValue}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="Avatar Border" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GameInfoPlayers.AvatarRing, TargetNullValue='-'}" Style="{StaticResource PlayerInformation.DetailValue}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.Server, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=SERVER}" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServerName}" Style="{StaticResource PlayerInformation.DetailValue}" />
                                    <TextBlock Grid.Row="3" Text="{Binding DataContext.PlayerInformationBindings.PlayerModeTranslation.LastUpdate, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=LAST_UPDATE}" Style="{StaticResource PlayerInformation.DetailLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TimestampText}" Style="{StaticResource PlayerInformation.DetailValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Panel.ZIndex="2" Style="{StaticResource App.TopFilterCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" MinWidth="240" MaxWidth="520" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa5:ImageAwesome Grid.Column="0"
                                          Icon="Solid_Search"
                                          Width="16"
                                          Height="16"
                                          Margin="0,0,9,0"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource SolidColorBrush.Text.2}" />
                        <TextBox x:Name="PlayerSearchTextBox"
                                 Grid.Column="1"
                                 TextChanged="TextBoxPlayerSearch_OnTextChanged"
                                 IsEnabled="{Binding PlayerInformationBindings.IsSearchedPlayerTabSelected}"
                                 IsReadOnly="{Binding PlayerInformationBindings.IsSearchInProgress}"
                                 Style="{StaticResource PlayerInformation.SearchTextBox}"
                                 ToolTip="{Binding PlayerInformationBindings.PlayerModeTranslation.Search, FallbackValue=SEARCH}" />
                        <Grid Grid.Column="2" Style="{StaticResource LoadingIconGridStyle}" VerticalAlignment="Center">
                            <fa5:ImageAwesome Visibility="{Binding PlayerInformationBindings.LoadIconVisibility}"
                                              Style="{StaticResource LoadingIconStyle}" />
                        </Grid>
                        <Button Grid.Column="3"
                                Width="32"
                                Height="32"
                                Margin="6,0,0,0"
                                Padding="0"
                                Click="CancelPlayerSearch_OnClick"
                                Style="{StaticResource Style.Button.Danger}"
                                ToolTip="{Binding PlayerInformationBindings.PlayerModeTranslation.Cancel, FallbackValue=CANCEL}"
                                Visibility="{Binding PlayerInformationBindings.IsSearchInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <fa5:ImageAwesome Icon="Solid_Times"
                                              Width="13"
                                              Height="13" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerInformationBindings.PlayerModeTranslation.Server, FallbackValue=SERVER}"
                                   Style="{StaticResource App.FilterLabel}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding PlayerInformationBindings.SearchServers}"
                                  SelectedItem="{Binding PlayerInformationBindings.SelectedSearchServer, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding PlayerInformationBindings.IsSearchInputEnabled}"
                                  SelectionChanged="SearchServer_OnSelectionChanged"
                                  Style="{StaticResource PlayerInformation.ServerComboBox}" />
                    </StackPanel>

                    <TabControl Grid.Column="2"
                                SelectedIndex="{Binding PlayerInformationBindings.SelectedPlayerTabIndex, Mode=TwoWay}"
                                Style="{StaticResource PlayerInformation.HeaderTabs}">
                        <TabItem Header="{Binding PlayerInformationBindings.PlayerModeTranslation.SearchedPlayer, FallbackValue=SEARCHED_PLAYER}" />
                        <TabItem Header="{Binding PlayerInformationBindings.PlayerModeTranslation.LocalPlayer, FallbackValue=LOCAL_PLAYER}" />
                    </TabControl>
                </Grid>

                <ProgressBar Grid.Row="1"
                             Visibility="{Binding PlayerInformationBindings.LoadBarVisibility}"
                             IsIndeterminate="True"
                             Height="2"
                             Margin="0,7,0,-9" />
            </Grid>
        </Border>

        <Popup IsOpen="{Binding PlayerInformationBindings.IsSearchResultOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=PlayerSearchTextBox}"
               Placement="Bottom"
               VerticalOffset="2"
               Width="{Binding ActualWidth, ElementName=PlayerSearchTextBox}"
               AllowsTransparency="True"
               StaysOpen="False"
               Panel.ZIndex="5">
            <Border Style="{StaticResource App.FilterDropdownPopup}" Padding="0">
                <ListBox SelectionMode="Single"
                         SelectionChanged="ListBoxUserSearch_OnSelectionChanged"
                         ItemsSource="{Binding PlayerInformationBindings.ListBoxUserSearchItems}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value.Name}"
                                           Foreground="{StaticResource SolidColorBrush.Text.1}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value.GuildName}"
                                           Foreground="{StaticResource SolidColorBrush.Text.5}"
                                           Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <Grid Grid.Row="1">
            <ContentControl Content="{Binding PlayerInformationBindings.PlayerModeInformation}" ContentTemplate="{StaticResource PlayerInformation.ProfileTemplate}"
                            Visibility="{Binding PlayerInformationBindings.IsSearchedPlayerTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ContentControl Content="{Binding PlayerInformationBindings.PlayerModeInformationLocal}" ContentTemplate="{StaticResource PlayerInformation.ProfileTemplate}"
                            Visibility="{Binding PlayerInformationBindings.IsLocalPlayerTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
