<UserControl x:Class="StatisticsAnalysisTool.UserControls.GuildControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <Grid>
        <TabControl SelectedIndex="1" Background="Transparent">
            <TabItem Header="{Binding GuildBindings.TranslationLootLogChecker, FallbackValue=LOOT_LOG_CHECKER}" Visibility="Collapsed">
                <!--<StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="32">
                        <Button Content="{Binding GuildBindings.TranslationReset, FallbackValue=RESET}" Margin="5,0" Height="32" Width="100" />
                    </StackPanel>
                    <StackPanel>
                        <Grid>
                            <vwp:VirtualizingItemsControl Margin="0,64,0,0" Width="430" ItemsSource="{Binding VaultBindings.VaultContainerContent, IsAsync=True, Mode=OneWay}" ItemTemplate="{StaticResource ContainerItemTemplate}"              
                                                          VirtualizingPanel.CacheLengthUnit="Item"
                                                          VirtualizingPanel.CacheLength="10,10"
                                                          VirtualizingPanel.ScrollUnit="Pixel"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Visible" />
                        </Grid>
                    </StackPanel>
                </StackPanel>-->
            </TabItem>
            <TabItem Header="{Binding GuildBindings.TranslationSiphonedEnergy, FallbackValue=SIPHONED_ENERGY}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ContentControl Grid.Row="0"
                                    ContentTemplate="{StaticResource ManuallySiphonedEnergy.Template}"
                                    Content="{Binding GuildBindings.ManuallySiphonedEnergy}" />

                    <Grid Grid.Row="1" Margin="12,0,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource App.FilterCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="3"
                                               Text="{Binding GuildBindings.TranslationTotalOverview, FallbackValue=TOTAL_OVERVIEW}"
                                               Style="{StaticResource Dashboard.SectionTitle}" />

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,8,0,0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding GuildBindings.SiphonedEnergyLastUpdateVisibility}">
                                        <TextBlock Text="{Binding GuildBindings.TranslationLastUpdate, StringFormat='{}{0:N0}: ', FallbackValue=LAST_UPDATE:}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding GuildBindings.SiphonedEnergyLastUpdate, StringFormat='{}{0} UTC', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=00:00:00}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="0,8,0,0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GuildBindings.TranslationTotal, StringFormat='{}{0:N0}: ', FallbackValue='TOTAL: '}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding GuildBindings.TotalSiphonedEnergyQuantity, StringFormat='{}{0} ', FallbackValue=0}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Separator Grid.Row="1" Height="4" Background="{StaticResource SolidColorBrush.Background.2}" />

                                <vwp:VirtualizingItemsControl Grid.Row="2"
                                                          Margin="0,20,0,0"
                                                          ItemsSource="{Binding GuildBindings.SiphonedEnergyOverviewList, IsAsync=True, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource SiphonedEnergyOverviewItemTemplate}" 
                                                          Background="{StaticResource SolidColorBrush.Accent.Blue.Transparent.5}"
                                                          VirtualizingPanel.CacheLengthUnit="Item"
                                                          VirtualizingPanel.CacheLength="10,10"
                                                          VirtualizingPanel.ScrollUnit="Pixel"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Visible" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource App.FilterCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding GuildBindings.TranslationDetails, FallbackValue=DETAILS}"
                                               Style="{StaticResource Dashboard.SectionTitle}" />
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{Binding GuildBindings.TranslationDeleteSelectedEntries, FallbackValue=DELETE__SELECTED__ENTRIES}"
                                                Padding="5,0"
                                                IsEnabled="{Binding TradeMonitoringBindings.IsDeleteTradesButtonEnabled}"
                                                Style="{StaticResource Style.Button.Danger}"
                                                Click="BtnDeleteSelectedSiphonedEnergyEntries_Click" />
                                        <Button Content="{Binding GuildBindings.TranslationSelectDeselectAll, FallbackValue=SELECT__DESELECT__ALL}"
                                                Margin="8,0,0,0"
                                                Padding="5,0"
                                                MaxWidth="300"
                                                Click="BtnSelectSwitchAllSiphonedEnergyEntries_Click" />
                                        <Grid Width="20"
                                              Height="20"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              MouseEnter="OpenSiphonedEnergyInfoPopup_MouseEnter"
                                              MouseLeave="CloseSiphonedEnergyInfoPopup_MouseLeave">
                                            <fa5:ImageAwesome Icon="Solid_InfoCircle" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <vwp:VirtualizingItemsControl Grid.Row="1"
                                                      Margin="0,8,0,0"
                                                      ItemsSource="{Binding GuildBindings.SiphonedEnergyCollectionView, IsAsync=True, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource SiphonedEnergyItemTemplate}"
                                                      d:ItemsSource="{d:SampleData ItemCount=10}"
                                                      VirtualizingPanel.CacheLengthUnit="Item"
                                                      VirtualizingPanel.CacheLength="10,10"
                                                      VirtualizingPanel.ScrollUnit="Pixel"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Visible" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Visibility="{Binding GuildBindings.GuildPopupVisibility, FallbackValue=Collapsed}" Margin="0,220,0,0" Background="{StaticResource SolidColorBrush.Background.2}">
            <StackPanel CanHorizontallyScroll="False" CanVerticallyScroll="True" Margin="10,0">
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription1}" Foreground="{StaticResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" Width="auto" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription2}" Foreground="{StaticResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" Width="auto" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription3}" Foreground="{StaticResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" Width="auto" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription4}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="16" TextWrapping="Wrap" Width="auto" />
                </StackPanel>
                <Image Margin="0,10" Source="../Assets/siphoned_energy_description01.jpg" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
