<UserControl x:Class="StatisticsAnalysisTool.UserControls.LossExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:crafting="clr-namespace:StatisticsAnalysisTool.Crafting"
             xmlns:translation="clr-namespace:StatisticsAnalysisTool.Models.TranslationModel"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             IsVisibleChanged="LossExplorerControl_OnIsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="LossExplorer.Card" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="205" />
            <Setter Property="Height" Value="260" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="LossExplorer.Badge" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Text.4}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="LossExplorer.TierBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource LossExplorer.Badge}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tier}" Value="1"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.1}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="2"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.2}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="3"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.3}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="4"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.4}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="5"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.5}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="6"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.6}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="7"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.7}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="8"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.8}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LossExplorer.EnchantmentBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource LossExplorer.Badge}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="0"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.0}" /></DataTrigger>
                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="1"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.1}" /></DataTrigger>
                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="2"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.2}" /></DataTrigger>
                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="3"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.3}" /></DataTrigger>
                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="4"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.4}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LossExplorer.QualityBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource LossExplorer.Badge}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding QualityLevel}" Value="1"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Quality.Color.1}" /></DataTrigger>
                <DataTrigger Binding="{Binding QualityLevel}" Value="2"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Quality.Color.2}" /></DataTrigger>
                <DataTrigger Binding="{Binding QualityLevel}" Value="3"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Quality.Color.3}" /></DataTrigger>
                <DataTrigger Binding="{Binding QualityLevel}" Value="4"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Quality.Color.4}" /></DataTrigger>
                <DataTrigger Binding="{Binding QualityLevel}" Value="5"><Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Quality.Color.5}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="LossExplorer.ItemsPanel">
            <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                       SpacingMode="None"
                                       StretchItems="False" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="LossExplorer.ItemTemplate" DataType="{x:Type crafting:LossExplorerItemRow}">
            <Border Style="{StaticResource LossExplorer.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding ItemName}"
                               Foreground="{StaticResource SolidColorBrush.Text.1}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1"
                               Margin="0,2,0,0"
                               Text="{Binding ItemUniqueName}"
                               Foreground="{StaticResource SolidColorBrush.Text.3}"
                               FontSize="10"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Row="2" Margin="0,7,0,4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Style="{StaticResource LossExplorer.TierBadge}">
                            <TextBlock Text="{Binding TierText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                        </Border>
                        <Border Style="{StaticResource LossExplorer.EnchantmentBadge}">
                            <TextBlock Text="{Binding EnchantmentText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                        </Border>
                        <Border Style="{StaticResource LossExplorer.QualityBadge}">
                            <TextBlock Text="{Binding QualityName}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                        </Border>
                    </StackPanel>

                    <Image Grid.Row="3" Width="96" Height="96" Source="{Binding Icon}" Stretch="Uniform" />

                    <StackPanel Grid.Row="4" Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/Resources/silver.png" Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform" />
                        <TextBlock Text="{Binding TotalValueText}"
                                   Foreground="{StaticResource SolidColorBrush.Text.1}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Margin="0,1,0,0"
                               Text="{Binding UnitValueText}"
                               Foreground="{StaticResource SolidColorBrush.Text.3}"
                               FontSize="11" HorizontalAlignment="Center" />

                    <TextBlock Grid.Row="6" Margin="0,3,0,0"
                               Text="{Binding QuantityText}"
                               Foreground="{StaticResource SolidColorBrush.Text.2}"
                               FontSize="12" HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10" DataContext="{Binding CraftingBindings.LossExplorer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource App.TopFilterCard}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="4,0,4,6" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fa5:ImageAwesome Grid.Column="0" Icon="Solid_Search" Width="16" Height="16" Margin="0,0,9,0"
                                      VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static translation:MainWindowTranslation.Search}"
                             Style="{StaticResource ItemSearchTextBoxStyle}" />
                    <Button Grid.Column="2" Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                            ToolTip="{x:Static translation:MainWindowTranslation.ResetFilters}"
                            Style="{StaticResource Style.Button.Neutral}"
                            Click="LossExplorerFilterReset_Click">
                        <fa5:ImageAwesome Icon="Solid_Redo" Width="14" Height="14" IsHitTestVisible="False"
                                          Foreground="{StaticResource SolidColorBrush.Text.1}" />
                    </Button>
                </Grid>

                <UniformGrid Grid.Column="1" Columns="4">
                    <StackPanel Style="{StaticResource ItemSearch.FilterField}">
                        <TextBlock Text="{x:Static translation:MainWindowTranslation.ShopCategory}"
                                   Style="{StaticResource App.FilterLabel}" />
                        <ComboBox ItemsSource="{Binding ItemShopCategories}"
                                  SelectedItem="{Binding SelectedItemShopCategory, Mode=TwoWay}"
                                  SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ItemSearch.FilterComboBox}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ItemSearch.FilterField}">
                        <TextBlock Text="{x:Static translation:MainWindowTranslation.Tier}"
                                   Style="{StaticResource App.FilterLabel}" />
                        <ComboBox ItemsSource="{Binding ItemTiers}"
                                  SelectedValue="{Binding SelectedItemTier, Mode=TwoWay}"
                                  SelectedValuePath="Key" DisplayMemberPath="Value"
                                  Style="{StaticResource ItemSearch.FilterComboBox}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ItemSearch.FilterField}">
                        <TextBlock Text="{x:Static translation:MainWindowTranslation.Enchantment}"
                                   Style="{StaticResource App.FilterLabel}" />
                        <ComboBox ItemsSource="{Binding ItemLevels}"
                                  SelectedValue="{Binding SelectedItemLevel, Mode=TwoWay}"
                                  SelectedValuePath="Key" DisplayMemberPath="Value"
                                  Style="{StaticResource ItemSearch.FilterComboBox}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ItemSearch.FilterField}">
                        <TextBlock Text="{x:Static crafting:LossExplorerBindings.TranslationQuality}"
                                   Style="{StaticResource App.FilterLabel}" />
                        <ComboBox ItemsSource="{Binding ItemQualities}"
                                  SelectedValue="{Binding SelectedItemQuality, Mode=TwoWay}"
                                  SelectedValuePath="Key" DisplayMemberPath="Value"
                                  Style="{StaticResource ItemSearch.FilterComboBox}" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6"
                Background="{StaticResource SolidColorBrush.Background.2}"
                BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SolidColorBrush.Text.2}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="16,0,0,0"
                           Text="{Binding StoredEventCountText}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="2" Height="4" Margin="10,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="{x:Static crafting:LossExplorerBindings.TranslationEquipment}">
                <Grid>
                    <vwp:VirtualizingItemsControl ItemsSource="{Binding EquipmentItems}"
                                                  ItemTemplate="{StaticResource LossExplorer.ItemTemplate}"
                                                  ItemsPanel="{StaticResource LossExplorer.ItemsPanel}"
                                                  VirtualizingPanel.CacheLengthUnit="Item"
                                                  VirtualizingPanel.CacheLength="10,10"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{x:Static crafting:LossExplorerBindings.TranslationNoData}"
                               Foreground="{StaticResource SolidColorBrush.Text.3}"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEquipmentItems}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static crafting:LossExplorerBindings.TranslationInventory}">
                <Grid>
                    <vwp:VirtualizingItemsControl ItemsSource="{Binding InventoryItems}"
                                                  ItemTemplate="{StaticResource LossExplorer.ItemTemplate}"
                                                  ItemsPanel="{StaticResource LossExplorer.ItemsPanel}"
                                                  VirtualizingPanel.CacheLengthUnit="Item"
                                                  VirtualizingPanel.CacheLength="10,10"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{x:Static crafting:LossExplorerBindings.TranslationNoData}"
                               Foreground="{StaticResource SolidColorBrush.Text.3}"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInventoryItems}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static crafting:LossExplorerBindings.TranslationCrafting}">
                <Grid>
                    <vwp:VirtualizingItemsControl ItemsSource="{Binding CraftingItems}"
                                                  ItemTemplate="{StaticResource LossExplorer.ItemTemplate}"
                                                  ItemsPanel="{StaticResource LossExplorer.ItemsPanel}"
                                                  VirtualizingPanel.CacheLengthUnit="Item"
                                                  VirtualizingPanel.CacheLength="10,10"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{x:Static crafting:LossExplorerBindings.TranslationNoData}"
                               Foreground="{StaticResource SolidColorBrush.Text.3}"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCraftingItems}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
