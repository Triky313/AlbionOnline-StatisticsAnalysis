<UserControl x:Class="StatisticsAnalysisTool.UserControls.GatheringControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:gathering="clr-namespace:StatisticsAnalysisTool.Gathering"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             mc:Ignorable="d"
             d:DesignHeight="1600" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <Grid Style="{StaticResource TabItemGridStyle}">
        <Grid Style="{StaticResource BackgroundImageGridStyle}" />
        <ScrollViewer x:Name="GatheringScrollViewer" Padding="12,10,12,18" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel MinWidth="1050" Width="{Binding ViewportWidth, ElementName=GatheringScrollViewer, Mode=OneWay}">
                <Border Style="{StaticResource App.TopFilterCard}" Margin="0,0,0,10">
                    <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border Style="{StaticResource App.FilterGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding GatheringBindings.TranslationGathering, FallbackValue=GATHERING}" Style="{StaticResource App.FilterLabel}" />
                                <Button Width="180" Height="32" Style="{StaticResource Style.Button.Neutral}" ToolTip="{Binding GatheringBindings.TranslationGatheringActive}" Click="GatheringActivationToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa5:ImageAwesome Width="16" Height="16" Margin="0,0,8,0" IsHitTestVisible="False">
                                            <fa5:ImageAwesome.Style>
                                                <Style TargetType="{x:Type fa5:ImageAwesome}">
                                                    <Setter Property="Icon" Value="Solid_ToggleOff" />
                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GatheringBindings.IsGatheringActive}" Value="True">
                                                            <Setter Property="Icon" Value="Solid_ToggleOn" />
                                                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </fa5:ImageAwesome.Style>
                                        </fa5:ImageAwesome>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Text" Value="{Binding Translation.TrackingIsNotActive}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GatheringBindings.IsGatheringActive}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Translation.TrackingIsActive}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource App.FilterGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding GatheringBindings.TranslationTimeRange, FallbackValue=TIME_RANGE}" Style="{StaticResource App.FilterLabel}" />
                                <ComboBox Width="170" Height="32" ItemsSource="{Binding GatheringBindings.GatheringTimeRanges}" SelectedItem="{Binding GatheringBindings.SelectedGatheringTimeRange, Mode=TwoWay}" DisplayMemberPath="Name" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource App.FilterGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding GatheringBindings.TranslationSession, FallbackValue=SESSION}" Style="{StaticResource App.FilterLabel}" />
                                <ComboBox Width="330" Height="32" HorizontalContentAlignment="Stretch" ItemsSource="{Binding GatheringBindings.GatheringSessionFilters}" SelectedItem="{Binding GatheringBindings.SelectedGatheringSessionFilter, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type gathering:GatheringSessionFilterOption}">
                                            <Grid MinWidth="290">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Style="{StaticResource Dashboard.SessionDeleteButton}" Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding DataContext.GatheringBindings.TranslationDeleteSession, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Click="DeleteGatheringSession_Click">
                                                    <fa5:ImageAwesome Width="10" Height="10" Icon="Solid_Times" Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource App.FilterGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding GatheringBindings.TranslationResetSession, FallbackValue=RESET_SESSION}" Style="{StaticResource App.FilterLabel}" />
                                <Button Height="32" MinWidth="160" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Click="BtnSessionReset_Click">
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <fa5:ImageAwesome Icon="Solid_Sync" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        <TextBlock Text="{Binding GatheringBindings.TranslationResetSession, FallbackValue=RESET_SESSION}" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>
                <TabControl Style="{StaticResource Dashboard.ContentTabControl}" ItemContainerStyle="{StaticResource Dashboard.ContentTabItem}" SelectedIndex="0">
                    <TabItem Header="{Binding GatheringBindings.TranslationGenerally, FallbackValue=GENERALLY}">
                        <StackPanel Margin="0,8,0,0">
                            <UniformGrid Rows="1" Columns="5" Margin="0,0,0,8">
                                <Border Style="{StaticResource Gathering.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="../Resources/silver.png" Style="{StaticResource Dashboard.SummaryImage}" Width="30" Height="30" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResourceValue}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, StringFormat={}{0:N0}}" Style="{StaticResource Dashboard.SummaryValue}" />
                                            <TextBlock Foreground="{StaticResource SolidColorBrush.Accent.Green.2}"><Run Text="{x:Static gathering:GatheringStats.TranslationPerHour}" /><Run Text=": " /><Run Text="{Binding GatheringBindings.GatheringStats.TotalGainedSilverPerHour, StringFormat={}{0:N0}/h}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Gathering.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="../Assets/pickaxe_box.png" Style="{StaticResource Dashboard.SummaryImage}" Width="30" Height="30" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalResources}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalResources, StringFormat={}{0:N0}}" Style="{StaticResource Dashboard.SummaryValue}" />
                                            <TextBlock Foreground="{StaticResource SolidColorBrush.Text.3}"><Run Text="{Binding GatheringBindings.GatheringStats.UniqueResourceTypes}" /><Run Text=" " /><Run Text="{x:Static gathering:GatheringStats.TranslationUniqueResourceTypes}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Gathering.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="../Assets/pickaxe_repeat.png" Style="{StaticResource Dashboard.SummaryImage}" Width="30" Height="30" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalGatheringProcesses}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalMiningProcesses, StringFormat={}{0:N0}}" Style="{StaticResource Dashboard.SummaryValue}" />
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalGatheringProcesses}" Foreground="{StaticResource SolidColorBrush.Text.3}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Gathering.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding GatheringBindings.GatheringStats.BestResource.Item.Icon, IsAsync=True}" Style="{StaticResource Dashboard.SummaryImage}" Width="38" Height="38" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationBestResource}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.BestResource.Item.LocalizedName, FallbackValue=-}" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource SolidColorBrush.Accent.Green.2}"><Run Text="{x:Static gathering:GatheringStats.TranslationValue}" /><Run Text=": " /><Run Text="{Binding GatheringBindings.GatheringStats.BestResource.TotalValue, StringFormat={}{0:N0}}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Gathering.SummaryCard}" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding GatheringBindings.GatheringStats.BestGatheringMap.IconSource}" Style="{StaticResource Dashboard.SummaryImage}" Width="34" Height="34" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTopMap}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap.Name, FallbackValue=-}" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource SolidColorBrush.Accent.Green.2}"><Run Text="{x:Static gathering:GatheringStats.TranslationValue}" /><Run Text=": " /><Run Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap.TotalValue, StringFormat={}{0:N0}}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Gathering.DetailCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationOverview}" Style="{StaticResource Gathering.CardTitle}" />
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalResourcesGathered}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalResources, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalGatheringProcesses}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalMiningProcesses, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationUniqueResourceTypes}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.UniqueResourceTypes}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationAverageResourceValue}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.AverageResourceValue, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationBestSingleGathering}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestSingleGatheringValue, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Gathering.DetailCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationMostGatheredResource}" Style="{StaticResource Gathering.CardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Image Source="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails.Item.Icon, IsAsync=True}" Width="58" Height="58" Margin="0,0,10,0" />
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails.Item.TierLevelString}" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails.Item.LocalizedName, FallbackValue=-}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" /></StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTimesGathered}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails.TimesGathered, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalAmount}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails.TotalAmount, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalValue}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails.TotalValue, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationAverageValuePerGather}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails.AverageValuePerGather, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Gathering.DetailCard}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationBestGatheringMap}" Style="{StaticResource Gathering.CardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Image Source="{Binding GatheringBindings.GatheringStats.BestGatheringMap.IconSource}" Width="48" Height="48" Margin="0,0,10,0" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap.Name, FallbackValue=-}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" /></StackPanel>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTimesGathered}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap.TimesGathered, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalValue}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap.TotalValue, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationUniqueResourceTypes}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap.ResourceTypeCount}" Style="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Style="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationMostGatheredResource}" Style="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap.MostGatheredResource.LocalizedName, FallbackValue=-}" Style="{StaticResource Gathering.DetailValue}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GatheringBindings.GatheringStats.BestGatheringMap.MostGatheredResource.LocalizedName}" /></Grid></Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Gathering.ChartCard}" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResourceValueByType}" Style="{StaticResource Gathering.CardTitle}" />
                                        <wpf:PieChart Grid.Row="1" Series="{Binding GatheringBindings.GatheringStats.ResourceValueByTypeSeries}" LegendPosition="Right" LegendTextPaint="{Binding GatheringBindings.ChartLegendTextPaint}" LegendTextSize="12" AnimationsSpeed="0:0:0" UpdaterThrottler="0:0:0.1" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Transparent" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Gathering.ChartCard}" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationGatheringActivityOverTime}" Style="{StaticResource Gathering.CardTitle}" />
                                            <ComboBox Grid.Column="1" Width="155" Height="26" ItemsSource="{Binding GatheringBindings.GatheringStats.ResourceChartValueTypes}" SelectedValue="{Binding GatheringBindings.GatheringStats.SelectedResourceChartValueType, Mode=TwoWay}" SelectedValuePath="GatheringChartValueType" DisplayMemberPath="Name" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1" Margin="0,4,0,3" ItemsSource="{Binding GatheringBindings.GatheringStats.ResourceChartSeriesFilters}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type gathering:GatheringChartSeriesFilter}">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,10,3" Foreground="{Binding Brush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <wpf:CartesianChart Grid.Row="2" Series="{Binding GatheringBindings.GatheringStats.ResourceChartSeries}" XAxes="{Binding GatheringBindings.GatheringStats.ResourceChartXAxes}" TooltipPosition="Center" FindingStrategy="ExactMatchTakeClosest" LegendPosition="Hidden" AnimationsSpeed="0:0:0" UpdaterThrottler="0:0:0.1" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Transparent" DrawMarginFrame="{x:Null}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Gathering.ChartCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationGatheringActivityByLocation}" Style="{StaticResource Gathering.CardTitle}" />
                                        <wpf:PieChart Grid.Row="1" Series="{Binding GatheringBindings.GatheringStats.GatheringActivityByLocationSeries}" LegendPosition="Right" LegendTextPaint="{Binding GatheringBindings.ChartLegendTextPaint}" LegendTextSize="12" AnimationsSpeed="0:0:0" UpdaterThrottler="0:0:0.1" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Transparent" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.45*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Gathering.ListCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResourceTypesGathered}" Style="{StaticResource Gathering.CardTitle}" Margin="12,0,12,9" />
                                        <Grid Margin="12,0,12,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResourceType}" Style="{StaticResource Gathering.TableHeader}" />
                                            <TextBlock Grid.Column="1" Text="{x:Static gathering:GatheringStats.TranslationAmount}" Style="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Static gathering:GatheringStats.TranslationValue}" Style="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Static gathering:GatheringStats.TranslationPercentOfTotal}" Style="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding GatheringBindings.GatheringStats.ResourceTypeSummaries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type gathering:GatheringResourceTypeSummary}">
                                                    <Border Style="{StaticResource Gathering.DetailRow}" Padding="12,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal"><Border Width="13" Height="13" Margin="0,0,7,0" Background="{Binding Brush}" CornerRadius="2" /><TextBlock Text="{Binding Name}" Style="{StaticResource Gathering.TableText}" /></StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SharePercentage, StringFormat='{}{0:N1}%'}" Style="{StaticResource Gathering.TableValue}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Gathering.ListCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTopGatheredResources}" Style="{StaticResource Gathering.CardTitle}" Margin="12,0,12,9" />
                                        <ItemsControl ItemsSource="{Binding GatheringBindings.GatheringStats.TopGatheredResources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type gathering:GatheringResourceSummary}">
                                                    <Border Style="{StaticResource Gathering.DetailRow}" Padding="8,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                                            <Image Grid.Column="1" Source="{Binding Item.Icon, IsAsync=True}" Width="32" Height="32" />
                                                            <StackPanel Grid.Column="2" Margin="6,0"><TextBlock Text="{Binding Item.LocalizedName}" Style="{StaticResource Gathering.TableText}" FontWeight="SemiBold" /><TextBlock Text="{Binding TopLocation}" FontSize="10" Foreground="{StaticResource SolidColorBrush.Text.3}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding TotalValue, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.TableValue}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Gathering.ListCard}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationRecentGatherings}" Style="{StaticResource Gathering.CardTitle}" Margin="12,0,12,9" />
                                        <Grid Margin="12,0,12,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="48" /><ColumnDefinition Width="60" /><ColumnDefinition Width="80" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResource}" Style="{StaticResource Gathering.TableHeader}" />
                                            <TextBlock Grid.Column="1" Text="{x:Static gathering:GatheringStats.TranslationTier}" Style="{StaticResource Gathering.TableHeader}" />
                                            <TextBlock Grid.Column="2" Text="{x:Static gathering:GatheringStats.TranslationAmount}" Style="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Static gathering:GatheringStats.TranslationValue}" Style="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{x:Static gathering:GatheringStats.TranslationMap}" Style="{StaticResource Gathering.TableHeader}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Translation.Time, FallbackValue=TIME}" Style="{StaticResource Gathering.TableHeader}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding GatheringBindings.GatheringStats.RecentGatherings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type gathering:Gathered}">
                                                    <Border Style="{StaticResource Gathering.DetailRow}" Padding="12,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="48" /><ColumnDefinition Width="60" /><ColumnDefinition Width="80" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                                                            <Image Source="{Binding Item.Icon, IsAsync=True}" Width="28" Height="28" HorizontalAlignment="Left" ToolTip="{Binding Item.LocalizedName}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Item.TierLevelString}" Style="{StaticResource Gathering.TableText}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding GainedTotalAmount, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding TotalMarketValueWithCulture, StringFormat={}{0:N0}}" Style="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="5" Text="{Binding ClusterUniqueName}" Style="{StaticResource Gathering.TableText}" />
                                                            <TextBlock Grid.Column="6" Text="{Binding TimestampDateTimeLocal, StringFormat={}{0:g}}" Style="{StaticResource Gathering.TableText}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationWood, FallbackValue=WOOD}"><ContentControl Margin="0,8,0,0" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource WoodTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationFiber, FallbackValue=FIBER}"><ContentControl Margin="0,8,0,0" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource FiberTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationOre, FallbackValue=ORE}"><ContentControl Margin="0,8,0,0" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource OreTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationHide, FallbackValue=HIDE}"><ContentControl Margin="0,8,0,0" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource HideTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationRock, FallbackValue=ROCK}"><ContentControl Margin="0,8,0,0" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource RockTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationFishing, FallbackValue=FISHING}"><ContentControl Margin="0,8,0,0" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource FishingTemplate}" /></TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
