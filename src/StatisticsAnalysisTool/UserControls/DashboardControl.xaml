                                                        <TextBlock Text="{Binding DataContext.TranslationKills, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                   Style="{StaticResource Dashboard.MobHeaderMetricTitle}" />
                                                        <TextBlock Text="{Binding Kills, StringFormat='{}{0:N0}', FallbackValue=0}"
                                                                   Style="{StaticResource Dashboard.MobHeaderMetricValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" Margin="5,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DataContext.TranslationPerHour, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                   Style="{StaticResource Dashboard.MobHeaderMetricTitle}" />
                                                        <TextBlock Text="{Binding KillsPerHour, StringFormat='{}{0:N1}/h', FallbackValue=0}"
                                                                   Style="{StaticResource Dashboard.MobHeaderMetricValue}" />
                                                    </StackPanel>
                                                    <WrapPanel Grid.Column="5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource Dashboard.MobTierTag}"
                                                                Visibility="{Binding HasTier, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding TierDisplay}" Style="{StaticResource Dashboard.MobTagText}" Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Dashboard.MobTypeTag}"
                                                                Visibility="{Binding HasMobTypeCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding MobTypeCategoryDisplay}" Style="{StaticResource Dashboard.MobTagText}" Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Dashboard.MobTag}"
                                                                Visibility="{Binding HasCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding CategoryDisplay}" Style="{StaticResource Dashboard.MobTagText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Dashboard.MobTag}"
                                                                Visibility="{Binding HasFaction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding FactionDisplay}" Style="{StaticResource Dashboard.MobTagText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Dashboard.MobTag}"
                                                                Visibility="{Binding HasAttackType, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding AttackTypeDisplay}" Style="{StaticResource Dashboard.MobTagText}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </Grid>
                                            </Expander.Header>

                                            <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Style="{StaticResource Dashboard.MobDetailGroup}">
                                                        <StackPanel>
                                                            <StackPanel Style="{StaticResource Dashboard.MobDetailTitlePanel}">
                                                                <iconPacks:PackIconGameIcons Kind="Info"
                                                                                             Style="{StaticResource Dashboard.MobDetailIcon}" />
                                                                <TextBlock Text="{Binding DataContext.TranslationOverview, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                           Style="{StaticResource Dashboard.MobDetailTitle}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemTemplate="{StaticResource Dashboard.MobDetailValueTemplate}"
                                                                          ItemsSource="{Binding OverviewStats}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource Dashboard.MobDetailGroup}">
                                                        <StackPanel>
                                                            <StackPanel Style="{StaticResource Dashboard.MobDetailTitlePanel}">
                                                                <iconPacks:PackIconGameIcons Kind="CrossedSwords"
                                                                                             Style="{StaticResource Dashboard.MobDetailIcon}" />
                                                                <TextBlock Text="{Binding DataContext.TranslationCombatStats, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                           Style="{StaticResource Dashboard.MobDetailTitle}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemTemplate="{StaticResource Dashboard.MobDetailValueTemplate}"
                                                                          ItemsSource="{Binding CombatStats}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource Dashboard.MobDetailGroup}">
                                                        <StackPanel>
                                                            <StackPanel Style="{StaticResource Dashboard.MobDetailTitlePanel}">
                                                                <iconPacks:PackIconGameIcons Kind="Awareness"
                                                                                             Style="{StaticResource Dashboard.MobDetailIcon}" />
                                                                <TextBlock Text="{Binding DataContext.TranslationAggroBehavior, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                           Style="{StaticResource Dashboard.MobDetailTitle}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemTemplate="{StaticResource Dashboard.MobDetailValueTemplate}"
                                                                          ItemsSource="{Binding AggroStats}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="3"
                                                            BorderThickness="0"
                                                            Style="{StaticResource Dashboard.MobDetailGroup}">
                                                        <StackPanel>
                                                            <StackPanel Style="{StaticResource Dashboard.MobDetailTitlePanel}">
                                                                <iconPacks:PackIconGameIcons Kind="Hourglass"
                                                                                             Style="{StaticResource Dashboard.MobDetailIcon}" />
                                                                <TextBlock Text="{Binding DataContext.TranslationSpawnCharges, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                           Style="{StaticResource Dashboard.MobDetailTitle}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemTemplate="{StaticResource Dashboard.MobDetailValueTemplate}"
                                                                          ItemsSource="{Binding SpawnStats}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </Grid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
