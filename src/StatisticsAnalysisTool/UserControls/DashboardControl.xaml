<UserControl x:Class="StatisticsAnalysisTool.UserControls.DashboardControl"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
             xmlns:bindingModels="clr-namespace:StatisticsAnalysisTool.Models.BindingModel"
             xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DesignHeight="1400"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">

    <Grid Style="{StaticResource TabItemGridStyle}">
        <Grid Style="{StaticResource BackgroundImageGridStyle}" />

        <ScrollViewer x:Name="DashboardScrollViewer" Padding="12,10,12,18" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel MinWidth="1050" Width="{Binding ViewportWidth, ElementName=DashboardScrollViewer, Mode=OneWay}">
                <Grid Margin="0,0,0,10">
                    <Border Style="{StaticResource App.TopFilterCard}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="250" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationTimeRange, FallbackValue=TIME_RANGE}" Style="{StaticResource App.FilterLabel}" />
                                    <ComboBox Width="155" ItemsSource="{Binding DashboardChartRanges}" SelectedItem="{Binding SelectedDashboardChartRange, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="DashboardChartRange_SelectionChanged" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationContent, FallbackValue=CONTENT}" Style="{StaticResource App.FilterLabel}" />
                                    <ComboBox Width="165" ItemsSource="{Binding DashboardContentFilters}" SelectedItem="{Binding SelectedDashboardContentFilter, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="DashboardMetadataFilter_SelectionChanged" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationSession, FallbackValue=SESSION}" Style="{StaticResource App.FilterLabel}" />
                                    <ComboBox MinWidth="220"
                                              HorizontalContentAlignment="Stretch"
                                              ItemsSource="{Binding DashboardSessionFilters}"
                                              SelectedItem="{Binding SelectedDashboardSessionFilter, Mode=TwoWay}"
                                              SelectionChanged="DashboardMetadataFilter_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:DashboardSessionFilterOption}">
                                                <Grid MinWidth="200">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource Dashboard.SessionDeleteButton}"
                                                            ToolTip="{x:Static bindingModels:DashboardBindings.TranslationDeleteSession}"
                                                            Click="DeleteDashboardSession_Click">
                                                        <fa5:ImageAwesome Width="10"
                                                                          Height="10"
                                                                          Icon="Solid_Times"
                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationResetSessionOnMapChange, FallbackValue=RESET_SESSION_ON_MAP_CHANGE}" Style="{StaticResource App.FilterLabel}" />
                                    <CheckBox Width="190" IsChecked="{Binding IsTrackingResetByMapChangeActive}" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" 
                                              VerticalAlignment="Bottom" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="4" Height="32" MinWidth="150" VerticalAlignment="Bottom" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Click="BtnSessionReset_Click">
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <fa5:ImageAwesome Icon="Solid_Sync" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationResetSession, FallbackValue=RESET_SESSION}" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Width="32" Height="32" Margin="8,0,0,0" Cursor="Hand" CornerRadius="4" Background="{StaticResource SolidColorBrush.Background.2}" 
                                        BorderBrush="{StaticResource SolidColorBrush.Text.6}" BorderThickness="1" Visibility="{Binding ShowOpenWindowButton, ElementName=DashboardRoot, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding Translation.OpenExtendedDashboardWindow, FallbackValue=OPEN_EXTENDED_DASHBOARD_WINDOW}" MouseUp="OpenDashboardWindow_MouseUp">
                                    <fa5:ImageAwesome Icon="Solid_Expand" Width="16" Height="16" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <TabControl Style="{StaticResource Dashboard.ContentTabControl}" ItemContainerStyle="{StaticResource Dashboard.ContentTabItem}" SelectedIndex="0">
                    <TabItem Header="{Binding DashboardBindings.TranslationDashboardTitle, FallbackValue=DASHBOARD}">
                        <StackPanel Margin="0,8,0,0">
                            <UniformGrid Rows="1" Columns="6" Margin="0,0,0,8">
                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/fame.png" Style="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationFame, FallbackValue=FAME}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.FameSummary}" 
                                                            ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/respec.png" Style="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationReSpec, FallbackValue=RESPEC}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.ReSpecSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/silver.png" Style="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationSilver, FallbackValue=SILVER}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.SilverSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/might.png" Style="{StaticResource Dashboard.SummaryImage}" Margin="0,-2,5,0" Height="24" Width="24" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationMight, FallbackValue=MIGHT}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.MightSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/favor.png" Style="{StaticResource Dashboard.SummaryImage}" Margin="0,-2,5,0" Height="24" Width="24" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationFavor, FallbackValue=FAVOR}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.FavorSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <fa5:ImageAwesome Icon="Regular_Clock" Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Top" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationSessionTime, FallbackValue=SESSION_TIME}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.SessionTimeSummary}" ContentTemplate="{StaticResource Dashboard.SummarySessionTimeTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Dashboard.FactionSummaryCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Style="{StaticResource Dashboard.SectionHeader}" MouseLeftButtonDown="FactionSummaryToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding DashboardBindings.SelectedFactionOption.SealIconSource}"
                                               Width="28"
                                               Height="28"
                                               Margin="12,0,9,0"
                                               Stretch="Uniform" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DashboardBindings.TranslationFaction, FallbackValue=FACTION}"
                                                   Style="{StaticResource Dashboard.ContentRankingTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2"
                                                          Icon="{Binding DashboardBindings.FactionSummaryToggleIcon, FallbackValue=Solid_Minus}"
                                                          Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>

                                    <Border Grid.Row="1"
                                            BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                            BorderThickness="0,1,0,0"
                                            Visibility="{Binding DashboardBindings.FactionSummaryVisibility}">
                                        <Grid Margin="14,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>

                                            <Image Source="{Binding DashboardBindings.SelectedFactionOption.SealIconSource}"
                                                   Width="74"
                                                   Height="74"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform" />

                                            <Border Grid.Column="1" Style="{StaticResource Dashboard.FactionMetricCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding DashboardBindings.SelectedFactionOption.CoinIconSource}"
                                                           Width="24"
                                                           Height="24"
                                                           Style="{StaticResource Dashboard.SummaryImage}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DashboardBindings.TranslationFactionPoints, FallbackValue=FACTION_POINTS}"
                                                                   Style="{StaticResource Dashboard.SummaryTitle}" />
                                                        <ContentControl Content="{Binding DashboardBindings.FactionPointsSummary}"
                                                                        ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}"
                                                                        HorizontalContentAlignment="Stretch" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource Dashboard.FactionMetricCard}" Margin="0,0,20,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding DashboardBindings.SelectedFactionOption.StandingIconSource}"
                                                           Width="24"
                                                           Height="24"
                                                           Style="{StaticResource Dashboard.SummaryImage}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DashboardBindings.TranslationFactionStanding, FallbackValue=FACTION_STANDING}"
                                                                   Style="{StaticResource Dashboard.SummaryTitle}" />
                                                        <ContentControl Content="{Binding DashboardBindings.FactionStandingSummary}"
                                                                        ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}"
                                                                        HorizontalContentAlignment="Stretch" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DashboardBindings.TranslationFaction, FallbackValue=FACTION}"
                                                           Style="{StaticResource App.FilterLabel}" />
                                                <ComboBox ItemsSource="{Binding DashboardBindings.FactionOptions}"
                                                          SelectedItem="{Binding DashboardBindings.SelectedFactionOption, Mode=TwoWay}"
                                                          SelectionChanged="DashboardMetadataFilter_SelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="26" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image Source="{Binding SealIconSource}" Width="20" Height="20" Stretch="Uniform" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Dashboard.ContentRankingCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Style="{StaticResource Dashboard.SectionHeader}" MouseLeftButtonDown="FameContentRankingToggle_OnMouseLeftButtonDown">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="../Resources/fame.png" Width="22" Height="22" Margin="13,0,9,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DashboardBindings.TranslationTopFameSources, FallbackValue=TOP_FAME_SOURCES}"
                                                       Style="{StaticResource Dashboard.ContentRankingTitle}" />
                                            <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.FameContentRankingToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1"
                                                      Margin="13,10,13,0"
                                                      Visibility="{Binding DashboardBindings.FameContentRankingVisibility}"
                                                      ItemsSource="{Binding DashboardBindings.FameContentRanking}"
                                                      ItemTemplate="{StaticResource Dashboard.ContentRankingItemTemplate}" />
                                        <Border Grid.Row="2"
                                                Margin="13,8,13,12"
                                                Padding="0,9,0,0"
                                                BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                                Visibility="{Binding DashboardBindings.FameContentRankingVisibility}"
                                                BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DashboardBindings.TranslationTotalFame, FallbackValue=TOTAL_FAME}"
                                                           Style="{StaticResource Dashboard.ContentRankingTotalLabel}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DashboardBindings.TotalFameByContent, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                                                           Style="{StaticResource Dashboard.ContentRankingTotalValue}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Dashboard.ContentRankingCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Style="{StaticResource Dashboard.SectionHeader}" MouseLeftButtonDown="SilverContentRankingToggle_OnMouseLeftButtonDown">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="../Resources/silver.png" Width="22" Height="22" Margin="13,0,9,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DashboardBindings.TranslationTopSilverSources, FallbackValue=TOP_SILVER_SOURCES}"
                                                       Style="{StaticResource Dashboard.ContentRankingTitle}" />
                                            <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.SilverContentRankingToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1"
                                                      Margin="13,10,13,0"
                                                      Visibility="{Binding DashboardBindings.SilverContentRankingVisibility}"
                                                      ItemsSource="{Binding DashboardBindings.SilverContentRanking}"
                                                      ItemTemplate="{StaticResource Dashboard.ContentRankingItemTemplate}" />
                                        <Border Grid.Row="2"
                                                Margin="13,8,13,12"
                                                Padding="0,9,0,0"
                                                BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                                Visibility="{Binding DashboardBindings.SilverContentRankingVisibility}"
                                                BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DashboardBindings.TranslationTotalSilver, FallbackValue=TOTAL_SILVER}"
                                                           Style="{StaticResource Dashboard.ContentRankingTotalLabel}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DashboardBindings.TotalSilverByContent, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                                                           Style="{StaticResource Dashboard.ContentRankingTotalValue}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Dashboard.Section}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Style="{StaticResource Dashboard.SectionHeader}" MouseLeftButtonDown="LootedChestsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/static_chest.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationLootedChests, FallbackValue=LOOTED_CHESTS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.LootedChestsStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.LootedChestsStatsVisibility}">
                                        <ContentControl Margin="5" Content="{Binding DashboardBindings.LootedChests}" ContentTemplate="{StaticResource LootedChestsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <userControls:DashboardLootControl Margin="0,0,0,8" ShowDetails="False" />

                            <Border Style="{StaticResource Dashboard.Section}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Style="{StaticResource Dashboard.SectionHeader}" MouseLeftButtonDown="ActivityChartToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <fa5:ImageAwesome Icon="Regular_Clock" Width="22" Height="22" Margin="12,0,10,0" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationActivityChart, FallbackValue=HISTORY}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.ActivityChartToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.ActivityChartVisibility}">
                                        <Grid Margin="12,10,12,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="320" />
                                            </Grid.RowDefinitions>
                                            <ItemsControl Grid.Row="0" Margin="0,0,0,4" ItemsSource="{Binding DashboardChartSeriesFilters}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:DashboardChartSeriesFilter}">
                                                        <Border Style="{StaticResource Dashboard.ChartFilter}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="DashboardChartSeriesVisibility_Changed" Unchecked="DashboardChartSeriesVisibility_Changed" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <wpf:CartesianChart Grid.Row="1" Series="{Binding SeriesDashboardHourValues}" XAxes="{Binding XAxesDashboardHourValues}" TooltipPosition="Center" FindingStrategy="ExactMatchTakeClosest" LegendPosition="Hidden" Background="Transparent" DrawMarginFrame="{x:Null}" />
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding DashboardBindings.TranslationLoot, FallbackValue=LOOT}">
                        <StackPanel Margin="0,8,0,0">
                            <userControls:DashboardLootControl />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding DashboardBindings.TranslationCombatTitle, FallbackValue=COMBAT}">
                        <StackPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Dashboard.Section}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Style="{StaticResource Dashboard.SectionHeader}" MouseLeftButtonDown="KillDeathToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/skull.png" Width="22" Height="22" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.KillsDeathsText, FallbackValue=KILLS_DEATHS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.KillDeathStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.KillDeathStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource KillDeathStatsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding DashboardBindings.TranslationEconomyTitle, FallbackValue=ECONOMY}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Dashboard.Section}" Margin="0,0,4,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Style="{StaticResource Dashboard.SectionHeader}" MouseLeftButtonDown="ReSpecStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/respec.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationReSpec, FallbackValue=RESPEC}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.ReSpecStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.ReSpecStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource SilverCostForReSpecTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Dashboard.Section}" Margin="4,0,0,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Style="{StaticResource Dashboard.SectionHeader}" MouseLeftButtonDown="RepairCostsStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/repair_cross.png" Width="26" Height="26" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationRepairCosts, FallbackValue=REPAIR_COSTS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.RepairCostsStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.RepairCostsStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource RepairCostsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Dashboard.Section}" Margin="0,8,4,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Style="{StaticResource Dashboard.SectionHeader}"
                                          MouseLeftButtonDown="ItemQualityRerollStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/quality_border.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DashboardBindings.TranslationRefineItemQuality, FallbackValue=REFINE_ITEM_QUALITY}"
                                                   Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2"
                                                          Icon="{Binding DashboardBindings.ItemQualityRerollStatsToggleIcon, FallbackValue=Solid_Minus}"
                                                          Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0"
                                            Visibility="{Binding DashboardBindings.ItemQualityRerollStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource ItemQualityRerollTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Dashboard.Section}" Margin="4,8,0,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Style="{StaticResource Dashboard.SectionHeader}"
                                          MouseLeftButtonDown="AwakenedWeaponStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <fa5:ImageAwesome Icon="Solid_Bolt" Width="24" Height="24" Margin="12,0,10,0"
                                                          Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DashboardBindings.TranslationAwakenWeapon, FallbackValue=AWAKEN_WEAPON}"
                                                   Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2"
                                                          Icon="{Binding DashboardBindings.AwakenedWeaponStatsToggleIcon, FallbackValue=Solid_Minus}"
                                                          Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                            BorderThickness="0,1,0,0"
                                            Visibility="{Binding DashboardBindings.AwakenedWeaponStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource AwakenedWeaponTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
