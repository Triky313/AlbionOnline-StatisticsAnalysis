<UserControl x:Class="StatisticsAnalysisTool.UserControls.DashboardControl"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="1000"
             d:DesignWidth="1400"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">

    <Grid Style="{StaticResource TabItemGridStyle}">
        <Grid Style="{StaticResource BackgroundImageGridStyle}" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="1050" Margin="12,10,12,18">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Dashboard.TopStatCard}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="../Resources/fame.png" Width="30" Height="30" ToolTip="{Binding Translation.Fame, FallbackValue=FAME}" />
                                <TextBlock Text="{Binding DashboardBindings.TotalGainedFameInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.TopStatValue}" />
                                <TextBlock Text="{Binding DashboardBindings.FamePerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}" Style="{StaticResource Dashboard.TopStatRate}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Dashboard.TopStatCard}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="../Resources/silver.png" Width="30" Height="30" ToolTip="{Binding Translation.Silver, FallbackValue=SILVER}" />
                                <TextBlock Text="{Binding DashboardBindings.TotalGainedSilverInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.TopStatValue}" />
                                <TextBlock Text="{Binding DashboardBindings.SilverPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}" Style="{StaticResource Dashboard.TopStatRate}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Dashboard.TopStatCard}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="../Resources/respec.png" Width="30" Height="30" ToolTip="{Binding Translation.ReSpec, FallbackValue=RESPEC}" />
                                <TextBlock Text="{Binding DashboardBindings.TotalGainedReSpecPointsInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.TopStatValue}" />
                                <TextBlock Text="{Binding DashboardBindings.ReSpecPointsPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}" Style="{StaticResource Dashboard.TopStatRate}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Dashboard.TopStatCard}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="../Resources/might.png" Width="30" Height="30" ToolTip="{Binding Translation.Might, FallbackValue=MIGHT}" />
                                <TextBlock Text="{Binding DashboardBindings.TotalGainedMightInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.TopStatValue}" />
                                <TextBlock Text="{Binding DashboardBindings.MightPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}" Style="{StaticResource Dashboard.TopStatRate}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Dashboard.TopStatCard}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="../Resources/favor.png" Width="30" Height="30" ToolTip="{Binding Translation.Favor, FallbackValue=FAVOR}" />
                                <TextBlock Text="{Binding DashboardBindings.TotalGainedFavorInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.TopStatValue}" />
                                <TextBlock Text="{Binding DashboardBindings.FavorPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}" Style="{StaticResource Dashboard.TopStatRate}" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding FactionPointStats}" ItemTemplate="{StaticResource DashboardFactionPointStatsTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid Margin="0,0,8,0">
                                <ToggleButton x:Name="DashboardCategoryButton" Style="{StaticResource App.FilterDropdownButton}" MinWidth="150" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <fa5:ImageAwesome Icon="Solid_Filter" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        <TextBlock Text="{Binding DashboardBindings.TranslationCategory, FallbackValue=CATEGORY}" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    </StackPanel>
                                </ToggleButton>
                                <Popup PlacementTarget="{Binding ElementName=DashboardCategoryButton}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=DashboardCategoryButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" Style="{StaticResource App.FilterDropdownPopup}" Width="250" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DashboardBindings.TranslationCategory, FallbackValue=CATEGORY}" Margin="2,0,0,8" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                            <Separator Margin="0,0,0,6" />
                                            <CheckBox Content="{Binding DashboardBindings.TranslationKillsDeaths, FallbackValue=KILLS_DEATHS}" IsChecked="{Binding DashboardBindings.IsKillDeathDashboardCategoryVisible, Mode=TwoWay}" Margin="2,4" />
                                            <CheckBox Content="{Binding DashboardBindings.TranslationLootedChests, FallbackValue=LOOTED_CHESTS}" IsChecked="{Binding DashboardBindings.IsLootedChestsDashboardCategoryVisible, Mode=TwoWay}" Margin="2,4" />
                                            <CheckBox Content="{Binding DashboardBindings.TranslationReSpec, FallbackValue=RESPEC}" IsChecked="{Binding DashboardBindings.IsReSpecDashboardCategoryVisible, Mode=TwoWay}" Margin="2,4" />
                                            <CheckBox Content="{Binding DashboardBindings.TranslationRepairCosts, FallbackValue=REPAIR_COSTS}" IsChecked="{Binding DashboardBindings.IsRepairCostsDashboardCategoryVisible, Mode=TwoWay}" Margin="2,4" />
                                            <CheckBox Content="{Binding DashboardBindings.TranslationActivityChart, FallbackValue=HISTORY}" IsChecked="{Binding DashboardBindings.IsActivityChartDashboardCategoryVisible, Mode=TwoWay}" Margin="2,4" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button Height="36" MinWidth="220" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Click="BtnTrackingReset_Click">
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <fa5:ImageAwesome Icon="Solid_Sync" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Text="{Binding Translation.ResetTrackingCounter, FallbackValue=RESET_TRACKING_COUNTER}" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                </StackPanel>
                            </Button>
                            <Border Width="38" Height="36" Margin="8,0,0,0" Cursor="Hand" CornerRadius="4" Background="{StaticResource SolidColorBrush.Background.2}" BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="1" Visibility="{Binding ShowOpenWindowButton, ElementName=DashboardRoot, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding Translation.OpenExtendedDashboardWindow, FallbackValue=OPEN_EXTENDED_DASHBOARD_WINDOW}" MouseUp="OpenDashboardWindow_MouseUp">
                                <fa5:ImageAwesome Icon="Solid_Expand" Width="16" Height="16" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                            </Border>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IsTrackingResetByMapChangeActive}" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Content="{Binding Translation.MapChangeReset, FallbackValue=MAP_CHANGE_RESET}" HorizontalAlignment="Right" Margin="0,9,0,0" />
                    </StackPanel>
                </Grid>


                <TabControl Style="{StaticResource Dashboard.ContentTabControl}"
                            ItemContainerStyle="{StaticResource Dashboard.ContentTabItem}"
                            SelectedIndex="0">
                    <TabItem Header="{Binding DashboardBindings.TranslationTitle, FallbackValue=DASHBOARD}">
                        <StackPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Dashboard.Section}" Margin="0,0,0,8" Visibility="{Binding DashboardBindings.IsKillDeathDashboardCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="KillDeathToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/skull.png" Width="22" Height="22" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.KillsDeathsText, FallbackValue=KILLS_DEATHS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.KillDeathStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.KillDeathStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource KillDeathStatsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Dashboard.Section}" Margin="0,0,0,8" Visibility="{Binding DashboardBindings.IsLootedChestsDashboardCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="LootedChestsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/static_chest.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationLootedChests, FallbackValue=LOOTED_CHESTS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.LootedChestsStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.LootedChestsStatsVisibility}">
                                        <ContentControl Margin="5" Content="{Binding DashboardBindings.LootedChests}" ContentTemplate="{StaticResource LootedChestsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Dashboard.Section}" Visibility="{Binding DashboardBindings.IsActivityChartDashboardCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="ActivityChartToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <fa5:ImageAwesome Icon="Regular_Clock" Width="22" Height="22" Margin="12,0,10,0" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationActivityChart, FallbackValue=HISTORY}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.ActivityChartToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.ActivityChartVisibility}">
                                        <Grid Margin="12,10,12,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="320" />
                                            </Grid.RowDefinitions>
                                            <WrapPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DashboardBindings.TranslationActivityChart, FallbackValue=HISTORY}" Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox Width="165" Height="26" Margin="0,0,14,0" ItemsSource="{Binding DashboardChartRanges}" SelectedItem="{Binding SelectedDashboardChartRange, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="DashboardChartRange_SelectionChanged" />

                                                <TextBlock Text="{Binding DashboardBindings.TranslationContent, FallbackValue=CONTENT}" Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox Width="160" Height="26" Margin="0,0,14,0" ItemsSource="{Binding DashboardContentFilters}" SelectedItem="{Binding SelectedDashboardContentFilter, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="DashboardMetadataFilter_SelectionChanged" />

                                                <TextBlock Text="{Binding DashboardBindings.TranslationSession, FallbackValue=SESSION}" Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox Width="280" Height="26" ItemsSource="{Binding DashboardSessionFilters}" SelectedItem="{Binding SelectedDashboardSessionFilter, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="DashboardMetadataFilter_SelectionChanged" />
                                            </WrapPanel>
                                            <ItemsControl Grid.Row="1" Margin="0,8,0,4" ItemsSource="{Binding DashboardChartSeriesFilters}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:DashboardChartSeriesFilter}">
                                                        <Border Style="{StaticResource Dashboard.ChartFilter}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="DashboardChartSeriesVisibility_Changed" Unchecked="DashboardChartSeriesVisibility_Changed" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <wpf:CartesianChart Grid.Row="2" Series="{Binding SeriesDashboardHourValues}" XAxes="{Binding XAxesDashboardHourValues}" TooltipPosition="Center" FindingStrategy="ExactMatchTakeClosest" LegendPosition="Hidden" Background="Transparent" DrawMarginFrame="{x:Null}" />
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Wirtschaft">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Visibility="{Binding DashboardBindings.IsReSpecDashboardCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Section}">
                                        <Setter Property="Margin" Value="0,0,4,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DashboardBindings.IsRepairCostsDashboardCategoryVisible}" Value="False">
                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                <Setter Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="ReSpecStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/respec.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationReSpec, FallbackValue=RESPEC}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.ReSpecStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.ReSpecStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource SilverCostForReSpecTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Visibility="{Binding DashboardBindings.IsRepairCostsDashboardCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Section}">
                                        <Setter Property="Margin" Value="4,0,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DashboardBindings.IsReSpecDashboardCategoryVisible}" Value="False">
                                                <Setter Property="Grid.Column" Value="0" />
                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                <Setter Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="RepairCostsStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/repair_cross.png" Width="26" Height="26" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationRepairCosts, FallbackValue=REPAIR_COSTS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.RepairCostsStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.RepairCostsStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource RepairCostsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
