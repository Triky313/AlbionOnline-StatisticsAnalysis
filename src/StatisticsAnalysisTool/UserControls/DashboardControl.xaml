<UserControl x:Class="StatisticsAnalysisTool.UserControls.DashboardControl"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="1000"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">

    <Grid Style="{StaticResource TabItemGridStyle}">
        <Grid Style="{StaticResource BackgroundImageGridStyle}" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="1050" Margin="12,10,12,18">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource App.FilterCard}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="230" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationTimeRange, FallbackValue=TIME_RANGE}" Style="{StaticResource App.FilterLabel}" />
                                    <ComboBox Width="155" Style="{StaticResource App.FilterComboBox}" ItemsSource="{Binding DashboardChartRanges}" SelectedItem="{Binding SelectedDashboardChartRange, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="DashboardChartRange_SelectionChanged" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationContent, FallbackValue=CONTENT}" Style="{StaticResource App.FilterLabel}" />
                                    <ComboBox Width="165" Style="{StaticResource App.FilterComboBox}" ItemsSource="{Binding DashboardContentFilters}" SelectedItem="{Binding SelectedDashboardContentFilter, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="DashboardMetadataFilter_SelectionChanged" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationSession, FallbackValue=SESSION}" Style="{StaticResource App.FilterLabel}" />
                                    <ComboBox MinWidth="220" Style="{StaticResource App.FilterComboBox}" ItemsSource="{Binding DashboardSessionFilters}" SelectedItem="{Binding SelectedDashboardSessionFilter, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="DashboardMetadataFilter_SelectionChanged" />
                                </StackPanel>
                            </Border>

                            <CheckBox Grid.Column="3" IsChecked="{Binding IsTrackingResetByMapChangeActive}" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Content="{Binding DashboardBindings.TranslationResetSessionOnMapChange, FallbackValue=RESET_SESSION_ON_MAP_CHANGE}" VerticalAlignment="Bottom" Margin="0,0,14,8" />

                            <Button Grid.Column="4" Height="32" MinWidth="150" VerticalAlignment="Bottom" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Click="BtnSessionReset_Click">
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <fa5:ImageAwesome Icon="Solid_Sync" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationResetSession, FallbackValue=RESET_SESSION}" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Width="38" Height="36" Cursor="Hand" CornerRadius="4" Background="{StaticResource SolidColorBrush.Background.2}" BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="1" Visibility="{Binding ShowOpenWindowButton, ElementName=DashboardRoot, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding Translation.OpenExtendedDashboardWindow, FallbackValue=OPEN_EXTENDED_DASHBOARD_WINDOW}" MouseUp="OpenDashboardWindow_MouseUp">
                                <fa5:ImageAwesome Icon="Solid_Expand" Width="16" Height="16" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TabControl Style="{StaticResource Dashboard.ContentTabControl}" ItemContainerStyle="{StaticResource Dashboard.ContentTabItem}" SelectedIndex="0">
                    <TabItem Header="{Binding DashboardBindings.TranslationDashboardTitle, FallbackValue=DASHBOARD}">
                        <StackPanel Margin="0,8,0,0">
                            <UniformGrid Rows="1" Columns="6" Margin="0,0,0,8">
                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/fame.png" Style="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationFame, FallbackValue=FAME}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.FameSummary}" 
                                                            ContentTemplate="{StaticResource Dashboard.SummaryMetricTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/respec.png" Style="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationReSpec, FallbackValue=RESPEC}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.ReSpecSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/silver.png" Style="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationSilver, FallbackValue=SILVER}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.SilverSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/might.png" Style="{StaticResource Dashboard.SummaryImage}" Margin="0,-2,5,0" Height="24" Width="24" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationMight, FallbackValue=MIGHT}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.MightSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/favor.png" Style="{StaticResource Dashboard.SummaryImage}" Margin="0,-2,5,0" Height="24" Width="24" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationFavor, FallbackValue=FAVOR}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.FavorSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Dashboard.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <fa5:ImageAwesome Icon="Regular_Clock" Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Top" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationSessionTime, FallbackValue=SESSION_TIME}" Style="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.SessionTimeSummary}" ContentTemplate="{StaticResource Dashboard.SummarySessionTimeTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Dashboard.Section}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="KillDeathToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/skull.png" Width="22" Height="22" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.KillsDeathsText, FallbackValue=KILLS_DEATHS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.KillDeathStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.KillDeathStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource KillDeathStatsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Dashboard.Section}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="LootedChestsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/static_chest.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationLootedChests, FallbackValue=LOOTED_CHESTS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.LootedChestsStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.LootedChestsStatsVisibility}">
                                        <ContentControl Margin="5" Content="{Binding DashboardBindings.LootedChests}" ContentTemplate="{StaticResource LootedChestsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Dashboard.Section}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="ActivityChartToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <fa5:ImageAwesome Icon="Regular_Clock" Width="22" Height="22" Margin="12,0,10,0" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationActivityChart, FallbackValue=HISTORY}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.ActivityChartToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.ActivityChartVisibility}">
                                        <Grid Margin="12,10,12,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="320" />
                                            </Grid.RowDefinitions>
                                            <ItemsControl Grid.Row="0" Margin="0,0,0,4" ItemsSource="{Binding DashboardChartSeriesFilters}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:DashboardChartSeriesFilter}">
                                                        <Border Style="{StaticResource Dashboard.ChartFilter}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="DashboardChartSeriesVisibility_Changed" Unchecked="DashboardChartSeriesVisibility_Changed" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <wpf:CartesianChart Grid.Row="1" Series="{Binding SeriesDashboardHourValues}" XAxes="{Binding XAxesDashboardHourValues}" TooltipPosition="Center" FindingStrategy="ExactMatchTakeClosest" LegendPosition="Hidden" Background="Transparent" DrawMarginFrame="{x:Null}" />
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding DashboardBindings.TranslationEconomyTitle, FallbackValue=ECONOMY}">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Dashboard.Section}" Margin="0,0,4,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="ReSpecStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="../Resources/respec.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationReSpec, FallbackValue=RESPEC}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.ReSpecStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.ReSpecStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource SilverCostForReSpecTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Dashboard.Section}" Margin="4,0,0,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Height="40" Cursor="Hand" MouseLeftButtonDown="RepairCostsStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/repair_cross.png" Width="26" Height="26" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationRepairCosts, FallbackValue=REPAIR_COSTS}" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <fa5:ImageAwesome Grid.Column="2" Icon="{Binding DashboardBindings.RepairCostsStatsToggleIcon, FallbackValue=Solid_Minus}" Style="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" Visibility="{Binding DashboardBindings.RepairCostsStatsVisibility}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource RepairCostsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
