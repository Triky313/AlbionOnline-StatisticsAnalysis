<UserControl x:Class="StatisticsAnalysisTool.UserControls.ItemDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
             xmlns:controls="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:ItemDetailsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000" mc:Ignorable="d">
    <Grid Background="{StaticResource SolidColorBrush.Background.1}">
        <Grid.RowDefinitions>
            <RowDefinition Height="105" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Style="{StaticResource ItemDetails.BorderColor.ItemLevel.Style}" DataContext="{Binding Item}" />

        <Grid Grid.Row="0" Background="{StaticResource SolidColorBrush.Background.1}">
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource SolidColorBrush.Background.2}" VerticalAlignment="Bottom" />
            <Image Source="{Binding Icon}" HorizontalAlignment="Left" Height="88" Margin="10,8,0,0" VerticalAlignment="Top" Width="88" />
            <StackPanel Margin="108,6,10,4">
                <StackPanel Orientation="Horizontal" Height="24">
                    <TextBlock Text="{Binding TitleName, FallbackValue=TITLE__NAME}" FontSize="16"
                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ItemTierLevel, FallbackValue=T0.0}" FontSize="16" Margin="5,0,0,0"
                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="22" Margin="0,1,0,0">
                    <Border Background="{StaticResource SolidColorBrush.Background.2}" BorderBrush="{StaticResource SolidColorBrush.Text.4}"
                            BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                        <TextBlock Text="{Binding ItemTier, FallbackValue=-}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="11" />
                    </Border>
                    <Border Background="{StaticResource SolidColorBrush.Background.2}" BorderBrush="{StaticResource SolidColorBrush.Text.4}"
                            BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                        <TextBlock Text="{Binding ItemCategoryName, FallbackValue=-}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="11" />
                    </Border>
                    <Border Background="{StaticResource SolidColorBrush.Background.2}" BorderBrush="{StaticResource SolidColorBrush.Text.4}"
                            BorderThickness="1" CornerRadius="3" Padding="5,1">
                        <TextBlock Text="{Binding ItemTypeName, FallbackValue=-}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="11" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding ItemUniqueName, FallbackValue=-}" Foreground="{StaticResource SolidColorBrush.Text.2}"
                           FontSize="11" Height="18" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Height="20">
                    <TextBlock Text="{Binding LastUpdatedText, FallbackValue=LAST__UPDATE: -}" Foreground="{StaticResource SolidColorBrush.Text.2}"
                               FontSize="11" VerticalAlignment="Center" />
                    <fa5:ImageAwesome Icon="Solid_Sync" Width="14" Height="14" Margin="6,0,0,0"
                                      ToolTip="{Binding LastUpdatedText, FallbackValue=LAST__UPDATE: -}"
                                      Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center"
                                      IsEnabled="{Binding CanRefreshManually}"
                                      MouseLeftButtonDown="Refresh_MouseLeftButtonDown">
                        <fa5:ImageAwesome.Style>
                            <Style TargetType="{x:Type fa5:ImageAwesome}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Cursor" Value="Arrow" />
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </fa5:ImageAwesome.Style>
                    </fa5:ImageAwesome>
                </StackPanel>
            </StackPanel>
            <ProgressBar Margin="0,1,0,0" Height="1" Minimum="{Binding TaskProgressbarMinimum}" Maximum="{Binding TaskProgressbarMaximum}"
                         Value="{Binding TaskProgressbarValue}" IsIndeterminate="{Binding IsTaskProgressbarIndeterminate}" VerticalAlignment="Top" />
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" Margin="0">
            <TabItem Header="{Binding Translation.Main, FallbackValue=MAIN}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="175" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="3*" MinHeight="220" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ItemDetails.Filter.Border}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Translation.Location, FallbackValue=LOCATION}"
                                           Foreground="{StaticResource SolidColorBrush.Text.2}" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <ComboBox Width="170" Height="26" ItemsSource="{Binding LocationFilters}"
                                          ItemTemplate="{StaticResource LocationFilterObjectTemplate}" />
                                <Border Width="1" Margin="10,2" Background="{StaticResource SolidColorBrush.Background.4}" />
                                <TextBlock Text="{Binding Translation.Quality, FallbackValue=QUALITY}"
                                           Foreground="{StaticResource SolidColorBrush.Text.2}" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <ListBox ItemsSource="{Binding MainTabBindings.Qualities}"
                                         SelectedItem="{Binding MainTabBindings.QualitiesSelection, Mode=TwoWay}"
                                         DisplayMemberPath="Name" SelectionMode="Single"
                                         Style="{StaticResource ItemDetails.Filter.ListBox}"
                                         ItemContainerStyle="{StaticResource ItemDetails.Filter.ListBoxItem}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource ItemDetails.Section.Border}">
                        <ListView ItemsSource="{Binding MainTabBindings.ItemPrices}" Language="{Binding ItemListViewLanguage}"
                                  SnapsToDevicePixels="True" BorderThickness="0" SelectionMode="Single"
                                  Foreground="{StaticResource SolidColorBrush.Text.1}" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  d:ItemsSource="{d:SampleData ItemCount=10}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnCityTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="LocationName" Content="{Binding Translation.Location, FallbackValue=LOCATION}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnSellPriceMinTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="SellPriceMin" Content="{Binding Translation.SellPriceMin, FallbackValue=SELL_PRICE_MIN}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnSellPriceMinDateTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="SellPriceMinDate" Content="{Binding Translation.SellPriceMinDate, FallbackValue=SELL_PRICE_MIN_DATE}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnSellPriceMaxTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="SellPriceMax" Content="{Binding Translation.SellPriceMax, FallbackValue=SELL_PRICE_MAX}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnSellPriceMaxDateTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="SellPriceMaxDate" Content="{Binding Translation.SellPriceMaxDate, FallbackValue=SELL_PRICE_MAX_DATE}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnBuyPriceMinTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="BuyPriceMin" Content="{Binding Translation.BuyPriceMin, FallbackValue=BUY_PRICE_MIN}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnBuyPriceMinDateTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="BuyPriceMinDate" Content="{Binding Translation.BuyPriceMinDate, FallbackValue=BUY_PRICE_MIN_DATE}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnBuyPriceMaxTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="BuyPriceMax" Content="{Binding Translation.BuyPriceMax, FallbackValue=BUY_PRICE_MAX}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn CellTemplate="{StaticResource GridViewColumnBuyPriceMaxDateTemplate}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="BuyPriceMaxDate" Content="{Binding Translation.BuyPriceMaxDate, FallbackValue=BUY_PRICE_MAX_DATE}" Click="GridViewColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

                    <Border Grid.Row="3" Style="{StaticResource ItemDetails.Section.Border}" Margin="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="10,5,8,0">
                                <ListBox DockPanel.Dock="Right" ItemsSource="{Binding HistoryBindings.TimeRanges}"
                                         SelectedItem="{Binding HistoryBindings.SelectedTimeRange, Mode=TwoWay}"
                                         DisplayMemberPath="Name" SelectionMode="Single"
                                         Style="{StaticResource ItemDetails.Filter.ListBox}"
                                         ItemContainerStyle="{StaticResource ItemDetails.Filter.ListBoxItem}" />
                                <TextBlock Text="{Binding Translation.History, FallbackValue=HISTORY}"
                                           Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="Bold"
                                           FontSize="13" VerticalAlignment="Center" />
                            </DockPanel>
                            <wpf:CartesianChart Grid.Row="1"
                                                Series="{Binding HistoryBindings.SeriesHistory}"
                                                XAxes="{Binding HistoryBindings.XAxesHistory}"
                                                TooltipPosition="Center"
                                                FindingStrategy="ExactMatchTakeClosest"
                                                LegendPosition="Top"
                                                LegendTextPaint="{Binding HistoryLegendTextPaint}"
                                                LegendTextSize="14"
                                                UseLayoutRounding="True"
                                                SnapsToDevicePixels="True"
                                                Background="Transparent"
                                                Margin="6,0,6,4"
                                                DrawMarginFrame="{x:Null}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Translation.Quality, FallbackValue=QUALITY}" ToolTip="{Binding Translation.TabAllQualityToolTipDescription}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ItemDetails.Filter.Border}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Translation.Location, FallbackValue=LOCATION}"
                                           Foreground="{StaticResource SolidColorBrush.Text.2}" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <ComboBox Width="170" Height="26" ItemsSource="{Binding LocationFilters}"
                                          ItemTemplate="{StaticResource LocationFilterObjectTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{Binding QualityTabBindings.Prices}" SnapsToDevicePixels="True" BorderThickness="0" SelectionMode="Single"
                              Foreground="{StaticResource SolidColorBrush.Text.1}" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{Binding Translation.Location, FallbackValue=LOCATION}" CellTemplate="{StaticResource GridViewColumn.CityForMarketQualityObjectTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Normal, FallbackValue=NORMAL}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinNormalTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Good, FallbackValue=GOOD}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinGoodTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Outstanding, FallbackValue=OUTSTANDING}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinOutstandingTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Excellent, FallbackValue=EXCELLENT}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinExcellentTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Masterpiece, FallbackValue=MASTERPIECE}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinMasterpieceTemplate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Translation.RealMoneyPrice, FallbackValue=REAL_MONEY_PRICE}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ItemDetails.Filter.Border}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Translation.Location, FallbackValue=LOCATION}"
                                           Foreground="{StaticResource SolidColorBrush.Text.2}" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <ComboBox Width="170" Height="26" ItemsSource="{Binding LocationFilters}"
                                          ItemTemplate="{StaticResource LocationFilterObjectTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{Binding QualityTabBindings.Prices}" SnapsToDevicePixels="True" BorderThickness="0" SelectionMode="Single"
                              Foreground="{StaticResource SolidColorBrush.Text.1}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{Binding Translation.City, FallbackValue=CITY}" CellTemplate="{StaticResource GridViewColumnCityTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Normal, FallbackValue=NORMAL}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinNormalRmTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Good, FallbackValue=GOOD}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinGoodRmTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Outstanding, FallbackValue=OUTSTANDING}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinOutstandingRmTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Excellent, FallbackValue=EXCELLENT}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinExcellentRmTemplate}"/>
                                <GridViewColumn Header="{Binding Translation.Masterpiece, FallbackValue=MASTERPIECE}" CellTemplate="{StaticResource GridViewColumn.SellPriceMinMasterpieceRmTemplate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Translation.Monitoring, FallbackValue=MONITORING}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{Binding Translation.MonitoringDescription, FallbackValue=ITEM_MONITORING_DESCRIPTION}"
                                   Foreground="{StaticResource SolidColorBrush.Text.2}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <Border Style="{StaticResource ItemDetails.Section.Border}" Margin="0,0,0,10">
                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_Tag" Width="16" Height="16" Margin="0,0,8,0"
                                                      Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
                                    <TextBlock Text="{Binding Translation.PriceMonitoring, FallbackValue=PRICE_MONITORING}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="Bold" FontSize="14" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Translation.PriceMonitoringDescription, FallbackValue=PRICE_MONITORING_DESCRIPTION}"
                                           Foreground="{StaticResource SolidColorBrush.Text.2}" TextWrapping="Wrap" Margin="0,5,0,10" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Translation.PriceLimit, FallbackValue=PRICE_LIMIT}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <controls:DigitsTextBox Text="{Binding PriceAlertThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsPriceAlertInactive}" MaxLength="20" Width="150" Height="26" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Translation.MaximumPriceAge, FallbackValue=MAXIMUM_PRICE_AGE}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <controls:DigitsTextBox Text="{Binding PriceAlertMaximumPriceAgeMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsPriceAlertInactive}" MaxLength="10" Width="100" Height="26" />
                                    <TextBlock Text="{Binding Translation.Minutes, FallbackValue=MINUTES}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Row="4" Content="{Binding Translation.IsAlertActive, FallbackValue=IS_ALERT_ACTIVE}"
                                          IsChecked="{Binding IsPriceAlertActive, Mode=OneWay}" Click="PriceAlert_Click"
                                          Margin="0,12,0,0" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ItemDetails.Section.Border}" Margin="0,0,0,10">
                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_Search" Width="16" Height="16" Margin="0,0,8,0"
                                                      Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                                    <TextBlock Text="{Binding Translation.MarketAvailability, FallbackValue=MARKET_AVAILABILITY}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="Bold" FontSize="14" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Translation.MarketAvailabilityDescription, FallbackValue=MARKET_AVAILABILITY_DESCRIPTION}"
                                           Foreground="{StaticResource SolidColorBrush.Text.2}" TextWrapping="Wrap" Margin="0,5,0,10" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Translation.MaximumPriceAge, FallbackValue=MAXIMUM_PRICE_AGE}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <controls:DigitsTextBox Text="{Binding AvailabilityAlertMaximumPriceAgeMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsAvailabilityAlertInactive}" MaxLength="10" Width="100" Height="26" />
                                    <TextBlock Text="{Binding Translation.Minutes, FallbackValue=MINUTES}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Row="3" Content="{Binding Translation.IsAlertActive, FallbackValue=IS_ALERT_ACTIVE}"
                                          IsChecked="{Binding IsAvailabilityAlertActive, Mode=OneWay}" Click="AvailabilityAlert_Click"
                                          Margin="0,12,0,0" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ItemDetails.Section.Border}" Margin="0,0,0,10"
                                Visibility="{Binding BlackMarketMonitoringVisibility}">
                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/flag_blackmarket.png" Width="20" Height="16" Margin="0,0,8,0"
                                           Stretch="Uniform" />
                                    <TextBlock Text="{Binding Translation.BlackMarketBuyOrderMonitoring, FallbackValue=BLACK_MARKET_BUY_ORDER_MONITORING}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="Bold" FontSize="14" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Translation.BlackMarketBuyOrderMonitoringDescription, FallbackValue=BLACK_MARKET_BUY_ORDER_MONITORING_DESCRIPTION}"
                                           Foreground="{StaticResource SolidColorBrush.Text.2}" TextWrapping="Wrap" Margin="0,5,0,10" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Translation.MinimumBuyOrderPrice, FallbackValue=MINIMUM_BUY_ORDER_PRICE}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <controls:DigitsTextBox Text="{Binding BlackMarketBuyOrderAlertThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsBlackMarketBuyOrderAlertInactive}" MaxLength="20" Width="150" Height="26" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Translation.MaximumPriceAge, FallbackValue=MAXIMUM_PRICE_AGE}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <controls:DigitsTextBox Text="{Binding BlackMarketAlertMaximumPriceAgeMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsBlackMarketBuyOrderAlertInactive}" MaxLength="10" Width="100" Height="26" />
                                    <TextBlock Text="{Binding Translation.Minutes, FallbackValue=MINUTES}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Row="4" Content="{Binding Translation.IsAlertActive, FallbackValue=IS_ALERT_ACTIVE}"
                                          IsChecked="{Binding IsBlackMarketBuyOrderAlertActive, Mode=OneWay}" Click="BlackMarketBuyOrderAlert_Click"
                                          Margin="0,12,0,0" />
                            </Grid>
                        </Border>

                        <CheckBox Content="{Binding Translation.PlayAlertSound, FallbackValue=PLAY_ALERT_SOUND}"
                                  IsChecked="{Binding IsAlertSoundEnabled, Mode=TwoWay}" Margin="2,2,0,8" />

                        <Border Visibility="{Binding MonitoringErrorVisibility}"
                                Background="{StaticResource SolidColorBrush.Background.2}" Padding="10" Margin="0,4,0,0">
                            <TextBlock Text="{Binding MonitoringErrorText}" Foreground="{StaticResource SolidColorBrush.Accent.Red.1}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Translation.Information, FallbackValue=INFORMATION}">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                    <Grid>
                        <StackPanel Margin="10,10,0,10" HorizontalAlignment="Left" Width="250">
                            <Label Content="{Binding Translation.ShopCategory, FallbackValue=SHOP_CATEGORY}" ContentStringFormat="{}{0:N2}:" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding Translation.ShopSubCategory, FallbackValue=SHOP_SUB_CATEGORY_1}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding Translation.Durability, FallbackValue=DURABILITY}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding Translation.CanBeOvercharged, FallbackValue=CAN_BE_OVERCHARGED}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding Translation.ShowInMarketplace, FallbackValue=SHOW_IN_MARKETPLACE}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding Translation.Weight, FallbackValue=WEIGHT}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                        </StackPanel>
                        <StackPanel Margin="265,10,0,10">
                            <Label Content="{Binding ExtraItemInformation.ShopCategory, FallbackValue=-, IsAsync=True, TargetNullValue=-}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding ExtraItemInformation.ShopSubCategory1, FallbackValue=-, IsAsync=True, TargetNullValue=-}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding ExtraItemInformation.Durability, FallbackValue=-, IsAsync=True, TargetNullValue=-}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding ExtraItemInformation.CanBeOvercharged, FallbackValue=-, IsAsync=True, TargetNullValue=-}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding ExtraItemInformation.ShowInMarketPlace, FallbackValue=-, IsAsync=True, TargetNullValue=-}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                            <Label Content="{Binding ExtraItemInformation.Weight, FallbackValue=-, IsAsync=true, TargetNullValue=-}" Style="{StaticResource ItemDetails.Information.FullInfoValue}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <userControls:ErrorBarControl Grid.Row="1" VerticalAlignment="Bottom"
                                      Visibility="{Binding ErrorBarVisibility, FallbackValue=Visible}"
                                      ErrorText="{Binding ErrorBarText}" ErrorException="{Binding ErrorBarException}" />
    </Grid>
</UserControl>
