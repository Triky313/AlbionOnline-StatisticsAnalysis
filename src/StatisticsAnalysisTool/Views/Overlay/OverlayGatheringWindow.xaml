<overlay:OverlayWindowBase x:Class="StatisticsAnalysisTool.Views.Overlay.OverlayGatheringWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:overlay="clr-namespace:StatisticsAnalysisTool.Views.Overlay"
                           xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
                           xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
                           xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                           mc:Ignorable="d"
                           d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
                           Title="SAT Overlay - Recoleccion">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A resource row is hidden until that resource type produced silver -->
            <Style x:Key="Overlay.ResourceRow" TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <DataTrigger.Value>
                            <sys:Int64>0</sys:Int64>
                        </DataTrigger.Value>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource Overlay.Card}" Width="270">
        <StackPanel>
            <TextBlock Text="{x:Static overlay:OverlayTranslation.GatheringTitle}" Style="{StaticResource Overlay.Title}" />

            <!-- Totals -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Resources/silver.png" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Style="{StaticResource Overlay.Value}" FontSize="19"
                               Text="{Binding GatheringBindings.GatheringStats.TotalGainedSilverPerHour, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat={}{0}/h, FallbackValue=0/h}" />
                    <TextBlock Style="{StaticResource Overlay.Sub}" FontSize="11"
                               ><Run Text="{x:Static overlay:OverlayTranslation.TotalSilver}" /><Run Text=" " /><Run Text="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, Mode=OneWay, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" /></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Image Source="pack://application:,,,/Assets/pickaxe_box.png" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Style="{StaticResource Overlay.Value}" FontSize="14"
                                   Text="{Binding GatheringBindings.GatheringStats.TotalResources, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Overlay.Sub}" FontSize="11" HorizontalAlignment="Right" Text="{x:Static overlay:OverlayTranslation.Resources}" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource Overlay.Border}" Margin="0,0,0,4" />

            <!-- Hint when gathering tracking is off -->
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,2" Foreground="#FFFFC864"
                       Text="{x:Static overlay:OverlayTranslation.GatheringTrackingOff}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GatheringBindings.IsGatheringActive}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Madera -->
            <Grid Margin="0,3,0,3" Tag="{Binding GatheringBindings.GatheringStats.GainedSilverByWood}" Style="{StaticResource Overlay.ResourceRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Source="pack://application:,,,/Assets/MiniMapMarker/minimapmarker_wood.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Static overlay:OverlayTranslation.Wood}" Style="{StaticResource Overlay.Sub}" Foreground="#FFC49A6C" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Style="{StaticResource Overlay.Value}" FontSize="13" HorizontalAlignment="Right"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverPerHourByWood, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat={}{0}/h, FallbackValue=0/h}" />
                <TextBlock Grid.Column="3" Margin="10,0,0,0" MinWidth="44" TextAlignment="Right" Style="{StaticResource Overlay.Sub}"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverByWood, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Style="{StaticResource Overlay.ShareBar}" Foreground="#FFC49A6C"
                             Maximum="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, FallbackValue=1}"
                             Value="{Binding GatheringBindings.GatheringStats.GainedSilverByWood, Mode=OneWay, FallbackValue=0}" />
            </Grid>
            <!-- Mineral -->
            <Grid Margin="0,3,0,3" Tag="{Binding GatheringBindings.GatheringStats.GainedSilverByOre}" Style="{StaticResource Overlay.ResourceRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Source="pack://application:,,,/Assets/MiniMapMarker/minimapmarker_ore.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Static overlay:OverlayTranslation.Ore}" Style="{StaticResource Overlay.Sub}" Foreground="#FF9DB4C0" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Style="{StaticResource Overlay.Value}" FontSize="13" HorizontalAlignment="Right"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverPerHourByOre, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat={}{0}/h, FallbackValue=0/h}" />
                <TextBlock Grid.Column="3" Margin="10,0,0,0" MinWidth="44" TextAlignment="Right" Style="{StaticResource Overlay.Sub}"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverByOre, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Style="{StaticResource Overlay.ShareBar}" Foreground="#FF9DB4C0"
                             Maximum="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, FallbackValue=1}"
                             Value="{Binding GatheringBindings.GatheringStats.GainedSilverByOre, Mode=OneWay, FallbackValue=0}" />
            </Grid>
            <!-- Fibra -->
            <Grid Margin="0,3,0,3" Tag="{Binding GatheringBindings.GatheringStats.GainedSilverByFiber}" Style="{StaticResource Overlay.ResourceRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Source="pack://application:,,,/Assets/MiniMapMarker/minimapmarker_fiber.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Static overlay:OverlayTranslation.Fiber}" Style="{StaticResource Overlay.Sub}" Foreground="#FFA8D47A" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Style="{StaticResource Overlay.Value}" FontSize="13" HorizontalAlignment="Right"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverPerHourByFiber, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat={}{0}/h, FallbackValue=0/h}" />
                <TextBlock Grid.Column="3" Margin="10,0,0,0" MinWidth="44" TextAlignment="Right" Style="{StaticResource Overlay.Sub}"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverByFiber, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Style="{StaticResource Overlay.ShareBar}" Foreground="#FFA8D47A"
                             Maximum="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, FallbackValue=1}"
                             Value="{Binding GatheringBindings.GatheringStats.GainedSilverByFiber, Mode=OneWay, FallbackValue=0}" />
            </Grid>
            <!-- Piel -->
            <Grid Margin="0,3,0,3" Tag="{Binding GatheringBindings.GatheringStats.GainedSilverByHide}" Style="{StaticResource Overlay.ResourceRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Source="pack://application:,,,/Assets/MiniMapMarker/minimapmarker_hide.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Static overlay:OverlayTranslation.Hide}" Style="{StaticResource Overlay.Sub}" Foreground="#FFD9A066" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Style="{StaticResource Overlay.Value}" FontSize="13" HorizontalAlignment="Right"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverPerHourByHide, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat={}{0}/h, FallbackValue=0/h}" />
                <TextBlock Grid.Column="3" Margin="10,0,0,0" MinWidth="44" TextAlignment="Right" Style="{StaticResource Overlay.Sub}"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverByHide, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Style="{StaticResource Overlay.ShareBar}" Foreground="#FFD9A066"
                             Maximum="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, FallbackValue=1}"
                             Value="{Binding GatheringBindings.GatheringStats.GainedSilverByHide, Mode=OneWay, FallbackValue=0}" />
            </Grid>
            <!-- Piedra -->
            <Grid Margin="0,3,0,3" Tag="{Binding GatheringBindings.GatheringStats.GainedSilverByRock}" Style="{StaticResource Overlay.ResourceRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Source="pack://application:,,,/Assets/MiniMapMarker/minimapmarker_stone.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Static overlay:OverlayTranslation.Rock}" Style="{StaticResource Overlay.Sub}" Foreground="#FFBDBDBD" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Style="{StaticResource Overlay.Value}" FontSize="13" HorizontalAlignment="Right"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverPerHourByRock, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat={}{0}/h, FallbackValue=0/h}" />
                <TextBlock Grid.Column="3" Margin="10,0,0,0" MinWidth="44" TextAlignment="Right" Style="{StaticResource Overlay.Sub}"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverByRock, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Style="{StaticResource Overlay.ShareBar}" Foreground="#FFBDBDBD"
                             Maximum="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, FallbackValue=1}"
                             Value="{Binding GatheringBindings.GatheringStats.GainedSilverByRock, Mode=OneWay, FallbackValue=0}" />
            </Grid>
            <!-- Pesca -->
            <Grid Margin="0,3,0,3" Tag="{Binding GatheringBindings.GatheringStats.GainedSilverByFish}" Style="{StaticResource Overlay.ResourceRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Source="pack://application:,,,/Assets/fishing_lure_box.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Static overlay:OverlayTranslation.Fishing}" Style="{StaticResource Overlay.Sub}" Foreground="#FF6FB7E8" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Style="{StaticResource Overlay.Value}" FontSize="13" HorizontalAlignment="Right"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverPerHourByFish, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat={}{0}/h, FallbackValue=0/h}" />
                <TextBlock Grid.Column="3" Margin="10,0,0,0" MinWidth="44" TextAlignment="Right" Style="{StaticResource Overlay.Sub}"
                           Text="{Binding GatheringBindings.GatheringStats.GainedSilverByFish, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Style="{StaticResource Overlay.ShareBar}" Foreground="#FF6FB7E8"
                             Maximum="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, FallbackValue=1}"
                             Value="{Binding GatheringBindings.GatheringStats.GainedSilverByFish, Mode=OneWay, FallbackValue=0}" />
            </Grid>
        </StackPanel>
    </Border>
</overlay:OverlayWindowBase>