<Window x:Class="StatisticsAnalysisTool.Views.LootComparatorSaveNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loot Comparator"
        Height="220"
        Width="520"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SolidColorBrush.Background.1}"
        FontSize="{StaticResource BaseFontSize}"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.2}" />

        <Grid Height="33" VerticalAlignment="Top" Background="{StaticResource SolidColorBrush.Background.3}"
              MouseDown="Hotbar_MouseDown">
            <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.2}" />
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.2}" />
            <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.2}" />
            <Label x:Name="TitleLabel" Margin="10,0,61,0" Height="33" FontSize="16"
                   Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="Bold" />
            <Button Style="{StaticResource WindowButtonStyle}" Content="r" Margin="-2,0,0,0" Click="CancelButton_Click" />
        </Grid>

        <StackPanel Margin="20,52,20,62">
            <TextBlock x:Name="PromptTextBlock" Foreground="{StaticResource SolidColorBrush.Text.1}"
                       FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBox x:Name="SaveNameTextBox" Height="30" MaxLength="100"
                     VerticalContentAlignment="Center" TextChanged="SaveNameTextBox_TextChanged" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Button x:Name="SaveButton" MinWidth="180" Height="34" Margin="0,0,8,0"
                    IsDefault="True" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" MinWidth="180" Height="34" Margin="8,0,0,0"
                    IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
