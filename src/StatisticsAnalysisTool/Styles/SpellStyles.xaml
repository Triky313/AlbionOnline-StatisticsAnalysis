<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:StatisticsAnalysisTool.Common.Controls"
                    xmlns:itemDetailsModels="clr-namespace:StatisticsAnalysisTool.Models.ItemDetailsModel">

    <SolidColorBrush x:Key="Spell.Type.Damage" Color="#FFFF2E2E" />
    <SolidColorBrush x:Key="Spell.Type.Heal" Color="#FF6ACC04" />
    <SolidColorBrush x:Key="Spell.Type.CrowdControl" Color="#FFFFB418" />
    <SolidColorBrush x:Key="Spell.Type.Debuff" Color="#FFC27AF0" />
    <SolidColorBrush x:Key="Spell.Type.Buff" Color="#FF20C7FF" />
    <SolidColorBrush x:Key="Spell.Type.Mobility" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Spell.Text" Color="#FFDDCDC3" />

    <Style x:Key="Spell.ToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="MaxWidth" Value="430" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Placement" Value="Mouse" />
        <Setter Property="HorizontalOffset" Value="12" />
        <Setter Property="VerticalOffset" Value="12" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Spell.TypeTemplate" DataType="{x:Type itemDetailsModels:ItemSpellType}">
        <Border Margin="0,0,5,0"
                Padding="6,2"
                Background="{StaticResource SolidColorBrush.Background.4}"
                CornerRadius="3">
            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="heal">
                                <Setter Property="Foreground" Value="{StaticResource Spell.Type.Heal}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="damage">
                                <Setter Property="Foreground" Value="{StaticResource Spell.Type.Damage}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="buff">
                                <Setter Property="Foreground" Value="{StaticResource Spell.Type.Buff}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="debuff">
                                <Setter Property="Foreground" Value="{StaticResource Spell.Type.Debuff}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="crowdcontrol">
                                <Setter Property="Foreground" Value="{StaticResource Spell.Type.CrowdControl}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="movement">
                                <Setter Property="Foreground" Value="{StaticResource Spell.Type.Mobility}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Spell.StatTemplate" DataType="{x:Type itemDetailsModels:ItemSpellStat}">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource SolidColorBrush.Text.3}" />
            <TextBlock Grid.Column="1" Margin="20,0,0,0" Text="{Binding Value}"
                       Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="SemiBold" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Spell.ToolTipContentTemplate" DataType="{x:Type itemDetailsModels:ItemSpellInformation}">
        <StackPanel Width="300">
            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" TextWrapping="Wrap" />

            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Types}" ItemTemplate="{StaticResource Spell.TypeTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Margin="0,11,0,0"
                    Padding="0,11,0,0"
                    BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding DescriptionVisibility, Mode=OneWay}">
                <controls:SpellDescriptionTextBlock
                    Segments="{Binding DescriptionSegments, Mode=OneWay}"
                    Foreground="{StaticResource Spell.Text}"
                    FontSize="12"
                    LineHeight="18"
                    TextWrapping="Wrap" />
            </Border>

            <Border Margin="5,12,5,0"
                    Padding="5,10,5,0"
                    BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding StatsVisibility, Mode=OneWay}">
                <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource Spell.StatTemplate}" />
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>