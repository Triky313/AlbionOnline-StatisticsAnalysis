    <DataTemplate x:Key="Dungeon.RunEntry.Metric.Template" DataType="{x:Type dungeonModels:DungeonRunMetric}">
        <Grid Height="21" Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="77" />
            </Grid.ColumnDefinitions>
            <Image Source="{Binding IconPath}" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="{Binding IconVisibility}" />
            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.3}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Value, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                       Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource SolidColorBrush.Text.1}" />
            <TextBlock Grid.Column="3" Margin="5,0,0,0" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding ValuePerHour, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat='{}({0} /h)'}"
                       Foreground="{StaticResource SolidColorBrush.Text.4}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValuePerHour}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dungeon.RunEntry.ChestItem.Template" DataType="{x:Type dungeonModels:Loot}">
        <Grid Width="44" Height="44" Margin="0,0,0,0" ToolTip="{Binding Item.LocalizedName}">
            <Image Margin="1" Source="{Binding Item.Icon}" Stretch="Uniform" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,5" Padding="2,0"
                    Background="{StaticResource SolidColorBrush.Background.1}" CornerRadius="2">
                <TextBlock Text="{Binding Quantity, StringFormat='{}x{0}'}" FontSize="12" Foreground="{StaticResource SolidColorBrush.Text.2}" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dungeon.RunEntry.Chest.Template" DataType="{x:Type dungeonModels:DungeonLootGroup}">
        <Border x:Name="ChestCard" Width="250" MinHeight="100" Margin="0,0,7,7" Padding="8"
                Background="{StaticResource SolidColorBrush.Background.3}" BorderThickness="1" CornerRadius="4">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Border.2}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static enumerations:TreasureRarity.Common}">
                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.1}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static enumerations:TreasureRarity.Uncommon}">
                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.2}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static enumerations:TreasureRarity.Rare}">
                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.3}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static enumerations:TreasureRarity.Legendary}">
                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.4}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding LootGroupIconPath}" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <Border Padding="5,2" HorizontalAlignment="Left" Background="{StaticResource SolidColorBrush.Background.1}" BorderThickness="1" CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Border.2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static enumerations:TreasureRarity.Common}">
                                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.1}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static enumerations:TreasureRarity.Uncommon}">
                                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.2}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static enumerations:TreasureRarity.Rare}">
                                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.3}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rarity}" Value="{x:Static enumerations:TreasureRarity.Legendary}">
                                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Level.Color.4}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOtherLoot}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Text.1}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                        </Border>
                        <StackPanel Margin="1,4,0,0" Orientation="Horizontal">
                            <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationTotalValue}" FontSize="12" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                            <TextBlock Margin="5,0,0,0" Text="{Binding TotalValue, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4,0,8" Visibility="{Binding MostValuableItemVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Height="40" Width="40" Margin="0" Source="{Binding MostValuableItem.Item.Icon}" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Margin="5,1,0,0">
                        <TextBlock Text="{Binding MostValuableItem.Item.LocalizedName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SolidColorBrush.Text.1}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MostValuableItem.EstimatedMarketValue.DoubleValue, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                       FontSize="12" Foreground="{StaticResource SolidColorBrush.Text.3}" />
                            <TextBlock Margin="5,0,0,0" Text="{Binding MostValuableItem.Quantity, StringFormat='{}x{0}'}"
                                       FontSize="12" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding DisplayedAdditionalItems}" ItemTemplate="{StaticResource Dungeon.RunEntry.ChestItem.Template}"
                              Visibility="{Binding AdditionalItemsVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Margin="0,0,0,0" Padding="5,2" HorizontalAlignment="Left"
                        Command="{Binding ToggleAdditionalItems}" Visibility="{Binding AdditionalItemsToggleVisibility}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}">
                    <TextBlock Text="{Binding AdditionalItemsToggleText}" FontSize="12" />
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Dungeon.RunEntry.CombatEvent.Template" DataType="{x:Type dungeonModels:DungeonCombatEvent}">
        <Border MinWidth="100" MinHeight="40" Margin="0,0,5,5" Padding="5" Background="{StaticResource SolidColorBrush.Background.3}" BorderThickness="1" CornerRadius="3">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static dungeon:KillStatus.OpponentDead}">
                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Green.3}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="32" Height="32" VerticalAlignment="Top">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Source" Value="../Assets/skull_red.png" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static dungeon:KillStatus.OpponentDead}">
                                    <Setter Property="Source" Value="../Assets/skull_green.png" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DiedName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Visibility="{Binding KilledByVisibility}">
                        <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationKilledBy}" FontSize="12" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                        <TextBlock Margin="5,0,0,0" Text="{Binding KilledBy}" FontSize="12"
                                   Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" TextTrimming="CharacterEllipsis" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Dungeon.ModernRunEntry.Template" DataType="{x:Type dungeonModels:DungeonBaseFragment}">
        <Border Style="{StaticResource Dungeon.RunEntry.Card}">
            <Grid MinHeight="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" IsHitTestVisible="False" Style="{StaticResource DungeonFragment.Faction}" />

                <Grid Grid.Column="0" Margin="10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding ContentIconPath}" Width="48" Height="48" VerticalAlignment="Top" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="{Binding EnterDungeonFirstTime, StringFormat='{}{0:g}'}" FontSize="9.5" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding ContentDisplayName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource SolidColorBrush.Text.1}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal" Visibility="{Binding MapNameVisibility}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DungeonFragment.ClusterTypeIcon.Template}" />
                            <TextBlock Margin="5,1,0,0" Text="{Binding MainMapName}" FontSize="10.5"
                                       Foreground="{StaticResource SolidColorBrush.Text.3}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <WrapPanel>
                            <Border Style="{StaticResource Dungeon.RunEntry.TierBadge}" Visibility="{Binding TierBadgeVisibility}">
                                <TextBlock Text="{Binding TierDisplayText}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                            </Border>
                            <Border Style="{StaticResource Dungeon.RunEntry.EnchantmentBadge}" Visibility="{Binding EnchantmentBadgeVisibility}">
                                <TextBlock Text="{Binding EnchantmentDisplayText}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource Dungeon.RunEntry.Divider}" Padding="10,8">
                    <ItemsControl ItemsSource="{Binding PerformanceMetrics}" ItemTemplate="{StaticResource Dungeon.RunEntry.Metric.Template}" />
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Dungeon.RunEntry.Divider}" Padding="10,10,7,4">
                    <StackPanel>
                        <Grid Visibility="{Binding LootGroupVisibility}">
                            <ItemsControl ItemsSource="{Binding DisplayedLootGroups}"
                                          ItemTemplate="{StaticResource Dungeon.RunEntry.Chest.Template}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        <Button Margin="0,0,5,5" Padding="10,5" HorizontalAlignment="Left"
                                Command="{Binding ToggleAdditionalChests}" Visibility="{Binding AdditionalChestToggleVisibility}"
                                Background="{StaticResource SolidColorBrush.Background.3}" BorderBrush="{StaticResource SolidColorBrush.Border.2}"
                                Foreground="{StaticResource SolidColorBrush.Text.2}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="../Assets/static_chest.png" Width="20" Height="20" Margin="5,0,5,0" />
                                <TextBlock Text="{Binding AdditionalChestToggleText}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel Visibility="{Binding CombatEventsVisibility}">
                            <ItemsControl ItemsSource="{Binding DisplayedCombatEvents}"
                                          ItemTemplate="{StaticResource Dungeon.RunEntry.CombatEvent.Template}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Margin="0,0,5,5" Padding="5,2" HorizontalAlignment="Left"
                                    Command="{Binding ToggleAdditionalCombatEvents}" Visibility="{Binding AdditionalCombatEventsToggleVisibility}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}">
                                <TextBlock Text="{Binding AdditionalCombatEventsToggleText}" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Dungeon.RunEntry.Divider}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding IsSelectedForDeletion}"
                                  ToolTip="{Binding TranslationSelectToDelete}" />
                        <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                            <fa5:ImageAwesome Icon="Solid_Users" Width="17" Height="17" Foreground="{StaticResource SolidColorBrush.Text.3}" />
                            <TextBlock Margin="7,0,0,0" Text="{Binding PartySize}" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                            <TextBlock Margin="5,1,0,0" Text="{Binding TranslationPlayers}" FontSize="9.5" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                            <fa5:ImageAwesome Icon="Regular_Clock" Width="17" Height="17" Foreground="{StaticResource SolidColorBrush.Text.3}" />
                            <TextBlock Margin="7,0,0,0" Text="{Binding TotalRunTimeInSeconds, Converter={StaticResource SecondsToTimeFormatConverter}}"
                                       FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        </StackPanel>
                        <WrapPanel Grid.Row="3" Margin="0,7,0,0">
                            <StackPanel Margin="0,0,8,0" Orientation="Horizontal" Visibility="{Binding FloorCountVisibility}">
                                <fa5:ImageAwesome Icon="Solid_Dungeon" Width="16" Height="16" Foreground="{StaticResource SolidColorBrush.Text.3}"
                                                  ToolTip="{Binding TranslationNumberOfDungeonFloors}" />
                                <TextBlock Margin="5,0,0,0" Text="{Binding FloorCount}" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DisplayedCheckPoints}" ItemTemplate="{StaticResource Dungeon.CheckPoint.Template}"
                                          Visibility="{Binding CheckPointVisibility}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>



    <DataTemplate x:Key="DungeonOptionsObjectTemplate" DataType="{x:Type dungeonModels:DungeonOptionsObject}">
        <StackPanel>
            <CheckBox IsChecked="{Binding IsDungeonPlayerLootVisible}"
                      Content="{Binding TranslationDungeonPlayerLootVisible, FallbackValue=DUNGEON_PLAYER_LOOT_VISIBLE}"
                      HorizontalContentAlignment="Left" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
