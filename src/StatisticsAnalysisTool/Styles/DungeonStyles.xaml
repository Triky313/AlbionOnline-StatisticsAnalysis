            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DungeonFragment.LootToggle.Template}" />
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding}" ContentTemplate="{StaticResource DungeonFragment.Kill.Template}" />
