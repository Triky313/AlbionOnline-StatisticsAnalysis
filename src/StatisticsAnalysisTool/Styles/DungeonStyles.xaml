                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rarity, IsAsync=True, Mode=OneWay}" Value="{x:Static cluster:MistsRarity.Uncommon}">
                                <Setter Property="Source" Value="../Assets/shiny_uncommon.png" />
