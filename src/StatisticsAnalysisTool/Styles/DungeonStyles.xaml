    <DataTemplate x:Key="DungeonFragment.Kill.Template" DataType="{x:Type dungeonModels:DungeonBaseFragment}">
        <StackPanel Orientation="Horizontal" Height="20">
            <StackPanel.Style>
                <Style TargetType="{x:Type StackPanel}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding KillStatus, IsAsync=True, Mode=OneWay}" Value="{x:Static dungeon:KillStatus.LocalPlayerDead}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding KillStatus, IsAsync=True, Mode=OneWay}" Value="{x:Static dungeon:KillStatus.OpponentDead}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Image Height="18" Margin="0,2,5,0">
                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Source" Value="../Assets/skull.png"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding KillStatus, IsAsync=True, Mode=OneWay}" Value="{x:Static dungeon:KillStatus.OpponentDead}">
                                <Setter Property="Source" Value="../Assets/skull_green.png"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KillStatus, IsAsync=True, Mode=OneWay}" Value="{x:Static dungeon:KillStatus.LocalPlayerDead}">
                                <Setter Property="Source" Value="../Assets/skull_red.png"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <TextBlock Text="{Binding DiedName, IsAsync=True, Mode=OneWay}" Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" Margin="2,2,2,0" />
            <TextBlock Text="{Binding TranslationKilledBy, IsAsync=True, Mode=OneWay, FallbackValue='KILLED_BY'}" 
                       Foreground="{StaticResource SolidColorBrush.Text.1}" Margin="2,2,2,0" Visibility="{Binding KilledByVisibility}" />
            <TextBlock Text="{Binding KilledBy, IsAsync=True, Mode=OneWay}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" Margin="2,2,2,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DungeonFragment.LootAndDeath.Template" DataType="{x:Type dungeonModels:DungeonBaseFragment}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
