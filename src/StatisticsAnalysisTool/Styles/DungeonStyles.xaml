        <Setter Property="MinWidth" Value="135" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
    </Style>

    <Style x:Key="Dungeon.OverviewMetricTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.3}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="Dungeon.OverviewMetricValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dungeon.OverviewMetricCaption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dungeon.SettingsCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Section}">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="13,11" />
    </Style>
    <Style x:Key="Dungeon.EfficiencyBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="19" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dungeon.LootToggle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="0,-2,0,2" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.Transparent.5}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <DataTemplate x:Key="DungeonFragment.LootToggle.Template" DataType="{x:Type dungeonModels:DungeonBaseFragment}">
        <Border Style="{StaticResource Dungeon.LootToggle}"
                ToolTip="{Binding LootToggleToolTip}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ShowLootedItems}" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24">
                    <Image Source="../Assets/static_chest.png" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="3,0,7,0">
                    <TextBlock Text="{Binding TotalValue, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LootSummaryText}" FontSize="10" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                </StackPanel>
                <TextBlock Grid.Column="2" FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                           Visibility="{Binding HasLootVisibility}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="&#x25BC;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ItemsContainerVisibility}" Value="Visible">
                                    <Setter Property="Text" Value="&#x25B2;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>

