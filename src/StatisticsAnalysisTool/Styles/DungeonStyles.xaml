<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    xmlns:converters="clr-namespace:StatisticsAnalysisTool.Common.Converters" 
                    xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
                    xmlns:dungeon="clr-namespace:StatisticsAnalysisTool.Dungeon"
                    xmlns:dungeonModels="clr-namespace:StatisticsAnalysisTool.Dungeon.Models"
                    xmlns:enumerations="clr-namespace:StatisticsAnalysisTool.Enumerations"
                    xmlns:cluster="clr-namespace:StatisticsAnalysisTool.Cluster"
                    xmlns:globalization="clr-namespace:System.Globalization;assembly=System.Runtime">

    <converters:ValueAvgConverter x:Key="ValueAvgConverter" />
    <converters:ShortNumberConverter x:Key="ShortNumberConverter" />
    <converters:EnumToIntOrQuestionMarkConverter x:Key="EnumToIntOrQuestionMarkConverter" />
    <converters:IntToStringOrQuestionMarkConverter x:Key="IntToStringOrQuestionMarkConverter" />
    <converters:SecondsToTimeFormatConverter x:Key="SecondsToTimeFormatConverter" />

    <converters:ShortNumberConverter x:Key="Dungeon.ShortNumberConverter" />
    <converters:DurationSecondsToCompactStringConverter x:Key="Dungeon.DurationConverter" />
    <Style x:Key="Dungeon.FilterToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Button.Secondary.Normal}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Button.Border.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="FilterSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FilterSurface" Property="Background" Value="{StaticResource SolidColorBrush.Button.Secondary.MouseOver}" />
                            <Setter TargetName="FilterSurface" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Button.Border.MouseOver}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="FilterSurface" Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.5}" />
                            <Setter TargetName="FilterSurface" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Button.Text.Disabled}" />
                            <Setter TargetName="FilterSurface" Property="Background" Value="{StaticResource SolidColorBrush.Button.Secondary.Disabled}" />
                            <Setter TargetName="FilterSurface" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Button.Border.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Dungeon.AnalyticsCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.SummaryCard}">
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="10,9" />
    </Style>

    <Style x:Key="Dungeon.DetailCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Section}">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="MinHeight" Value="235" />
    </Style>

    <Style x:Key="Dungeon.SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Dungeon.DeltaText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="ToolTip" Value="{Binding DataContext.DungeonBindings.Analytics.ComparisonText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPositiveChange}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.3}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsNegativeChange}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Dungeon.SummaryMetricTemplate" DataType="{x:Type dungeonModels:DungeonMetric}">
        <StackPanel>
            <WrapPanel>
                <TextBlock Text="{Binding Value, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                           Style="{StaticResource Dashboard.SummaryValue}" />
                <TextBlock Text="{Binding ValuePerHour, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat='{}({0} /h)', FallbackValue=0}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Dashboard.SummaryPerHourText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPerHourValue}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </WrapPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text=" " Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                           Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text=" (" Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text=")" Style="{StaticResource Dungeon.DeltaText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dungeon.DurationMetricTemplate" DataType="{x:Type dungeonModels:DungeonMetric}">
        <StackPanel>
            <TextBlock Text="{Binding Value, Converter={StaticResource Dungeon.DurationConverter}, FallbackValue=0m}"
                       Style="{StaticResource Dashboard.SummaryValue}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text=" " Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource Dungeon.DurationConverter}, FallbackValue=0m}"
                           Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text=" (" Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dungeon.DeltaText}" />
                <TextBlock Text=")" Style="{StaticResource Dungeon.DeltaText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Dungeon.ContentTabs" TargetType="{x:Type ListBox}">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="Dungeon.ContentTab" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Border.2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="TabBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4,4,0,0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Border.1}" />
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SolidColorBrush.Surface.Selected}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Border.Focus}" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter Property="Panel.ZIndex" Value="2" />
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SolidColorBrush.Background.5}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.6}" />
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.6}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

