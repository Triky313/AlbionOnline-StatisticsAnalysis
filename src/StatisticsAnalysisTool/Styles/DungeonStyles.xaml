    <DataTemplate x:Key="Dungeon.Stats.Template" DataType="{x:Type dungeonModels:DungeonStats}">
        <StackPanel Height="420">
            <!-- Total View -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.Total.Template}" Content="{Binding StatsTotal}" />

            <!-- Solo dungeons -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.Solo.Template}" Content="{Binding StatsSolo}" />

            <!-- Standard dungeons -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.Standard.Template}" Content="{Binding StatsStandard}" />

            <!-- Avalonian dungeons -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.Avalonian.Template}" Content="{Binding StatsAvalonian}" />

            <!-- Mists -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.Mists.Template}" Content="{Binding StatsMists}" />

            <!-- Mists dungeon -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.MistsDungeon.Template}" Content="{Binding StatsMistsDungeon}" />

            <!-- Expedition -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.Expedition.Template}" Content="{Binding StatsExpedition}" />

            <!-- Corrupted -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.Corrupted.Template}" Content="{Binding StatsCorrupted}" />

            <!-- HellGate -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.HellGate.Template}" Content="{Binding StatsHellGate}" />

            <!-- Abyssal Depths -->
            <ContentPresenter ContentTemplate="{StaticResource Stats.AbyssalDepths.Template}" Content="{Binding StatsAbyssalDepths}" />
        </StackPanel>
    </DataTemplate>

    <!-- Filter settings template -->
    <DataTemplate x:Key="DungeonStatsFilterTemplate" DataType="{x:Type dungeon:DungeonStatsFilter}">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="auto" Margin="0,0,0,0">
            <DockPanel Margin="0,0,0,0" Height="30" VerticalAlignment="Top" Width="auto" HorizontalAlignment="Left">
                <CheckBox Content="T?" Margin="5,0,5,0" IsChecked="{Binding IsTierUnknown}"/>
                <CheckBox Content="{Binding TranslationT1, FallbackValue='T1'}" Margin="5,0,5,0" IsChecked="{Binding IsT1}"/>
                <CheckBox Content="{Binding TranslationT2, FallbackValue='T2'}" Margin="5,0,5,0" IsChecked="{Binding IsT2}"/>
                <CheckBox Content="{Binding TranslationT3, FallbackValue='T3'}" Margin="5,0,5,0" IsChecked="{Binding IsT3}"/>
                <CheckBox Content="{Binding TranslationT4, FallbackValue='T4'}" Margin="5,0,5,0" IsChecked="{Binding IsT4}"/>
                <CheckBox Content="{Binding TranslationT5, FallbackValue='T5'}" Margin="5,0,5,0" IsChecked="{Binding IsT5}"/>
                <CheckBox Content="{Binding TranslationT6, FallbackValue='T6'}" Margin="5,0,5,0" IsChecked="{Binding IsT6}"/>
                <CheckBox Content="{Binding TranslationT7, FallbackValue='T7'}" Margin="5,0,5,0" IsChecked="{Binding IsT7}"/>
                <CheckBox Content="{Binding TranslationT8, FallbackValue='T8'}" Margin="5,0,5,0" IsChecked="{Binding IsT8}"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,0" Height="30" VerticalAlignment="Top" Width="auto" HorizontalAlignment="Left">
                <CheckBox ToolTip="{Binding TranslationUnknown}" Margin="5,0,5,0" IsChecked="{Binding IsLevelUnknown}">
                    <CheckBox.Content>
                        <Label>?</Label>
                    </CheckBox.Content>
                </CheckBox>
                <CheckBox ToolTip="{Binding TranslationFlat}" Margin="5,0,5,0" IsChecked="{Binding IsLevel0}">
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="../Assets/gem_level0.png" Height="11" Width="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
                <CheckBox ToolTip=".0" Margin="5,0,5,0" IsChecked="{Binding IsLevel1}">
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="../Assets/gem_level1.png" Height="11" Width="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
                <CheckBox ToolTip=".1" Margin="5,0,5,0" IsChecked="{Binding IsLevel2}">
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="../Assets/gem_level2.png" Height="11" Width="11" Margin="-5,2,0,0" />
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
                <CheckBox ToolTip=".2" Margin="5,0,5,0" IsChecked="{Binding IsLevel3}">
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="../Assets/gem_level3.png" Height="11" Width="11" Margin="-5,2,0,0" />
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
                <CheckBox ToolTip=".3" Margin="5,0,5,0" IsChecked="{Binding IsLevel4}">
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="../Assets/gem_level4.png" Height="11" Width="11" Margin="-5,2,0,0" />
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dungeon.CheckPoint.Template" DataType="{x:Type dungeonModels:CheckPoint}">
        <Grid Width="18">
            <Image>
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="../Assets/checkpoint.png" />
                        <Setter Property="ToolTip" Value="{Binding TranslationCheckPoint, IsAsync=True, Mode=OneWay}" />
                        <Setter Property="Opacity" Value="0.50" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status, IsAsync=True, Mode=OneWay}" Value="{x:Static enumerations:CheckPointStatus.Unknown}">
                                <Setter Property="Opacity" Value="0.25" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status, IsAsync=True, Mode=OneWay}" Value="{x:Static enumerations:CheckPointStatus.Active}">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status, IsAsync=True, Mode=OneWay}" Value="{x:Static enumerations:CheckPointStatus.Done}">
                                <Setter Property="Opacity" Value="0.75" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DungeonFragment.RandomDungeon.MapTypeIcon.Template" DataType="{x:Type dungeonModels:RandomDungeonFragment}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-10,0,-10">
            <Image Height="46" Width="38">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level, IsAsync=True, Mode=OneWay}" Value="1">
                                <Setter Property="Source" Value="../Assets/butterfly_uncommon.png" />
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, IsAsync=True, Mode=OneWay}" Value="2">
                                <Setter Property="Source" Value="../Assets/butterfly_rare.png" />
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, IsAsync=True, Mode=OneWay}" Value="3">
                                <Setter Property="Source" Value="../Assets/butterfly_epic.png" />
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, IsAsync=True, Mode=OneWay}" Value="4">
                                <Setter Property="Source" Value="../Assets/butterfly_legendary.png" />
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </StackPanel>
    </DataTemplate>
    
    <DataTemplate x:Key="DungeonFragment.Mists.MapTypeIcon.Template" DataType="{x:Type dungeonModels:MistsFragment}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Height="34" Width="34">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rarity, IsAsync=True, Mode=OneWay}" Value="{x:Static cluster:MistsRarity.Unknown}">
                                <Setter Property="Source" Value="../Assets/shiny_common.png" />
                                <Setter Property="Visibility" Value="Visible" />
