<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
                    xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
                    xmlns:bindingModel="clr-namespace:StatisticsAnalysisTool.Models.BindingModel"
                    xmlns:converters="clr-namespace:StatisticsAnalysisTool.Common.Converters"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    mc:Ignorable="d">

    <converters:ShortNumberConverter x:Key="ShortNumberConverter" />
    <converters:DurationSecondsToCompactStringConverter x:Key="DurationSecondsToCompactStringConverter" />

    <Style x:Key="Dashboard.Section" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Dashboard.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="Dashboard.SummaryCard" TargetType="{x:Type Border}">
        <Setter Property="MinWidth" Value="164" />
        <Setter Property="Height" Value="82" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="9,8" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style x:Key="Dashboard.SummaryTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dashboard.SummaryValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="Margin" Value="0,1,0,1" />
    </Style>

    <Style x:Key="Dashboard.SummaryDeltaText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="ToolTip" Value="{Binding DataContext.DashboardBindings.SummaryComparisonText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=VS_PREVIOUS_HOUR}" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.3}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDecrease}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dashboard.SummaryImage" TargetType="{x:Type Image}">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <DataTemplate x:Key="Dashboard.SummaryMetricTemplate" DataType="{x:Type models:DashboardSummaryMetric}">
        <StackPanel>
            <TextBlock Text="{Binding Value, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                       Style="{StaticResource Dashboard.SummaryValue}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" " Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" (" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=")" Style="{StaticResource Dashboard.SummaryDeltaText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dashboard.SummarySessionTimeTemplate" DataType="{x:Type models:DashboardSummaryMetric}">
        <StackPanel>
            <TextBlock Text="{Binding Value, Converter={StaticResource DurationSecondsToCompactStringConverter}, FallbackValue=0m}" Style="{StaticResource Dashboard.SummaryValue}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" " Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Dashboard.SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.SectionToggleIcon" TargetType="{x:Type fa5:ImageAwesome}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.ChartFilter" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
    </Style>

    <Style x:Key="Dashboard.ContentTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Dashboard.ContentTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="HeaderBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4,4,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.5}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dashboard.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Card}">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="Dashboard.MetricTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Dashboard.MetricLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.MetricValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.MetricValue.Death" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Dashboard.MetricValue}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
    </Style>

    <Style x:Key="Dashboard.CostLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.CostValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="KillDeathStatsTemplate" DataType="{x:Type bindingModel:DashboardBindings}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.65*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Dashboard.MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="27" />
                        <RowDefinition Height="27" />
                        <RowDefinition Height="27" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{Binding TranslationSoloKills, FallbackValue=SOLO_KILLS}" Style="{StaticResource Dashboard.MetricTitle}" />
                    <TextBlock Grid.Row="1" Text="{Binding TranslationToday, FallbackValue=TODAY}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SoloKillsToday, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                    <TextBlock Grid.Row="2" Text="{Binding TranslationWeek, FallbackValue=WEEK}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SoloKillsThisWeek, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                    <TextBlock Grid.Row="3" Text="{Binding TranslationMonth, FallbackValue=MONTH}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SoloKillsThisMonth, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Dashboard.MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="27" />
                        <RowDefinition Height="27" />
                        <RowDefinition Height="27" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{Binding TranslationKills, FallbackValue=KILLS}" Style="{StaticResource Dashboard.MetricTitle}" />
                    <TextBlock Grid.Row="1" Text="{Binding TranslationToday, FallbackValue=TODAY}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KillsToday, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                    <TextBlock Grid.Row="2" Text="{Binding TranslationWeek, FallbackValue=WEEK}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KillsThisWeek, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                    <TextBlock Grid.Row="3" Text="{Binding TranslationMonth, FallbackValue=MONTH}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding KillsThisMonth, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Dashboard.MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="27" />
                        <RowDefinition Height="27" />
                        <RowDefinition Height="27" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{Binding TranslationDeaths, FallbackValue=DEATHS}" Style="{StaticResource Dashboard.MetricTitle}" Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" />
                    <TextBlock Grid.Row="1" Text="{Binding TranslationToday, FallbackValue=TODAY}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeathsToday, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue.Death}" />
                    <TextBlock Grid.Row="2" Text="{Binding TranslationWeek, FallbackValue=WEEK}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeathsThisWeek, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue.Death}" />
                    <TextBlock Grid.Row="3" Text="{Binding TranslationMonth, FallbackValue=MONTH}" Style="{StaticResource Dashboard.MetricLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeathsThisMonth, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue.Death}" />
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Dashboard.MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TranslationAverageItemPowerWhenKilling, FallbackValue=AVERAGE_ITEM_POWER_WHEN_KILLING}" Style="{StaticResource Dashboard.MetricLabel}" TextWrapping="Wrap" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding AverageItemPowerWhenKilling, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                    <TextBlock Grid.Row="1" Text="{Binding TranslationAverageItemPowerOfTheKilledEnemies, FallbackValue=AVERAGE_ITEM_POWER_OF_KILLED_ENEMIES}" Style="{StaticResource Dashboard.MetricLabel}" TextWrapping="Wrap" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AverageItemPowerOfTheKilledEnemies, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                    <TextBlock Grid.Row="2" Text="{Binding TranslationAverageItemPowerWhenDying, FallbackValue=AVERAGE_ITEM_POWER_WHEN_DYING}" Style="{StaticResource Dashboard.MetricLabel}" TextWrapping="Wrap" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AverageItemPowerWhenDying, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.MetricValue}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,5,0">
                <TextBlock Text="{Binding TranslationDataFromAlbionOnlineServers, StringFormat='{}*{0}', FallbackValue=DATA_FROM_ALBION_ONLINE_SERVERS}" FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.5}" />
                <TextBlock Text="  |  " FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.5}" />
                <TextBlock Text="{Binding TranslationLastUpdate, StringFormat='{}{0}: ', FallbackValue=LAST_UPDATE:}" FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.5}" />
                <TextBlock Text="{Binding LastUpdate, StringFormat='{}{0:HH:mm:ss} UTC', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue='-- UTC'}" FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.5}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SilverCostForReSpecTemplate" DataType="{x:Type bindingModel:DashboardBindings}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TranslationPaidSilverForReSpecThisSession, FallbackValue=PAID_SILVER_FOR_RESPEC_THIS_SESSION}" Style="{StaticResource Dashboard.CostLabel}" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="../Resources/silver.png" Height="16" Width="16" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding TotalSilverCostForReSpecInSession, StringFormat='{}-{0:N0}', FallbackValue='-0'}" Style="{StaticResource Dashboard.CostValue}" />
                </StackPanel>
            </Grid>
            <Separator Grid.Row="1" Margin="0,4" Background="{StaticResource SolidColorBrush.Background.4}" />
            <Grid Grid.Row="2" Margin="2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TranslationPaidSilverForReSpecPerHour, FallbackValue=PAID_SILVER_FOR_RESPEC_PER_HOUR}" Style="{StaticResource Dashboard.CostLabel}" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="../Resources/silver.png" Height="16" Width="16" Margin="0,0,5,0" />
                    <TextBlock Text="-" Style="{StaticResource Dashboard.CostValue}" />
                    <TextBlock Text="{Binding SilverCostForReSpecHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue='0/h'}" Style="{StaticResource Dashboard.CostValue}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RepairCostsTemplate" DataType="{x:Type bindingModel:DashboardBindings}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TranslationRepairCostsToday, FallbackValue=REPAIR_COSTS_TODAY}" Style="{StaticResource Dashboard.CostLabel}" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="../Resources/silver.png" Height="16" Width="16" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RepairCostsToday, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, StringFormat='{}-{0}', FallbackValue='-0'}" Style="{StaticResource Dashboard.CostValue}" />
                </StackPanel>
            </Grid>
            <Separator Grid.Row="1" Margin="0,4" Background="{StaticResource SolidColorBrush.Background.4}" />
            <Grid Grid.Row="2" Margin="2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TranslationRepairCostsLast7Days, FallbackValue=REPAIR_COSTS_LAST_7_DAYS}" Style="{StaticResource Dashboard.CostLabel}" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="../Resources/silver.png" Height="16" Width="16" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RepairCostsLast7Days, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, StringFormat='{}-{0}', FallbackValue='-0'}" Style="{StaticResource Dashboard.CostValue}" />
                </StackPanel>
            </Grid>
            <Separator Grid.Row="3" Margin="0,4" Background="{StaticResource SolidColorBrush.Background.4}" />
            <Grid Grid.Row="4" Margin="2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TranslationRepairCostsLast30Days, FallbackValue=REPAIR_COSTS_LAST_30_DAYS}" Style="{StaticResource Dashboard.CostLabel}" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="../Resources/silver.png" Height="16" Width="16" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RepairCostsLast30Days, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, StringFormat='{}-{0}', FallbackValue='-0'}" Style="{StaticResource Dashboard.CostValue}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <Style x:Key="Dashboard.ChestCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Card}">
        <Setter Property="Margin" Value="5" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="Dashboard.ChestTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="Dashboard.ChestRow" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="Dashboard.ChestLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="3,0,6,0" />
    </Style>

    <Style x:Key="Dashboard.ChestValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="LootedChestsTemplate" DataType="{x:Type models:LootedChests}">
        <UniformGrid Columns="3" Rows="2">
            <Border Style="{StaticResource Dashboard.ChestCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="5" Text="{Binding TranslationRandomSoloDungeons, FallbackValue=RANDOM_SOLO_DUNGEONS}" Style="{StaticResource Dashboard.ChestTitle}" />
                        <Grid Grid.Row="1" Grid.Column="1" Width="34" Height="34" HorizontalAlignment="Center">
                            <Image Source="/Assets/static_chest.png" Width="23" Height="23" />
                            <Image Source="/Assets/green_glow.png" Width="34" Height="34" Opacity="0.65" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="2" Width="34" Height="34" HorizontalAlignment="Center">
                            <Image Source="/Assets/static_chest.png" Width="23" Height="23" />
                            <Image Source="/Assets/blue_glow.png" Width="34" Height="34" Opacity="0.65" />
