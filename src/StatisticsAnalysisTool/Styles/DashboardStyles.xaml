    <DataTemplate x:Key="Dashboard.CombatEventItemTemplate" DataType="{x:Type models:DashboardCombatEventItem}">
        <Expander Style="{StaticResource Dashboard.CombatEventExpander}">
            <Expander.Header>
                <Grid MinHeight="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RelativeTime}" Style="{StaticResource Dashboard.CombatRowText}" />
