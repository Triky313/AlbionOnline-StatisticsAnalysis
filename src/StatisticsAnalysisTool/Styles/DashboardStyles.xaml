<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
                    xmlns:dungeon="clr-namespace:StatisticsAnalysisTool.Dungeon"
                    xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
                    xmlns:bindingModel="clr-namespace:StatisticsAnalysisTool.Models.BindingModel"
                    xmlns:converters="clr-namespace:StatisticsAnalysisTool.Common.Converters"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    mc:Ignorable="d">

    <converters:ShortNumberConverter x:Key="ShortNumberConverter" />
    <converters:DurationSecondsToCompactStringConverter x:Key="DurationSecondsToCompactStringConverter" />

    <Style x:Key="Dashboard.Section" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Dashboard.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="Dashboard.SummaryCard" TargetType="{x:Type Border}">
        <Setter Property="MinWidth" Value="164" />
        <Setter Property="MinHeight" Value="82" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="9,8" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style x:Key="Dashboard.FactionSummaryCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Section}">
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style x:Key="Dashboard.FactionMetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.SummaryCard}">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="Dashboard.SummaryTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dashboard.SummaryValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="Margin" Value="0,1,0,1" />
    </Style>

    <Style x:Key="Dashboard.SummaryDeltaText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="ToolTip" Value="{Binding DataContext.DashboardBindings.SummaryComparisonText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=VS_PREVIOUS_HOUR}" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.3}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDecrease}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dashboard.SummaryPerHourText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="5,2,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}" />
    </Style>

    <Style x:Key="Dashboard.SummaryImage" TargetType="{x:Type Image}">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="Dashboard.LootBreakdownName" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.3}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.LootBreakdownValue" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="Dashboard.LootSummaryMetricTemplate" DataType="{x:Type models:DashboardLootStatistics}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TotalValueSummary.Value, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}"
                           Style="{StaticResource Dashboard.SummaryValue}" />
                <TextBlock Margin="5,2,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SolidColorBrush.Text.4}">
                    <Run Text="(" />
                    <Run Text="{Binding LootPerHour, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}" />
                    <Run Text="/h)" />
                </TextBlock>
            </StackPanel>
            <StackPanel DataContext="{Binding TotalValueSummary}" Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" " Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" (" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=")" Style="{StaticResource Dashboard.SummaryDeltaText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dashboard.LootValueBreakdownItemTemplate" DataType="{x:Type models:DashboardLootBreakdownItem}">
        <Grid Height="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="85" />
                <ColumnDefinition Width="135" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Dashboard.LootBreakdownName}" />
                <Image Source="/Resources/silver.png" Width="14" Height="14" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding ItemCount, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                       TextAlignment="Right"
                       Style="{StaticResource Dashboard.LootBreakdownValue}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding SharePercentage, StringFormat='{}{0:N1} %', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                       TextAlignment="Right"
                       Style="{StaticResource Dashboard.LootBreakdownValue}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dashboard.LootShareBreakdownItemTemplate" DataType="{x:Type models:DashboardLootBreakdownItem}">
        <Grid Height="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Dashboard.LootBreakdownName}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding SharePercentage, StringFormat='{}{0:N1} %', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                       TextAlignment="Right"
                       Style="{StaticResource Dashboard.LootBreakdownValue}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dashboard.SummaryMetricTemplate" DataType="{x:Type models:DashboardSummaryMetric}">
        <StackPanel>
            <TextBlock Text="{Binding Value, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                       Style="{StaticResource Dashboard.SummaryValue}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" " Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" (" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=")" Style="{StaticResource Dashboard.SummaryDeltaText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dashboard.SummaryMetricWithPerHourTemplate" DataType="{x:Type models:DashboardSummaryMetric}">
        <StackPanel>
            <WrapPanel>
                <TextBlock Text="{Binding Value, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}"
                           Style="{StaticResource Dashboard.SummaryValue}" />
                <TextBlock Text="{Binding ValuePerHour, Mode=OneWay, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, StringFormat='{}({0} /h)', FallbackValue=0}"
                           Style="{StaticResource Dashboard.SummaryPerHourText}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" " Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" (" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=")" Style="{StaticResource Dashboard.SummaryDeltaText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dashboard.SummarySessionTimeTemplate" DataType="{x:Type models:DashboardSummaryMetric}">
        <StackPanel>
            <TextBlock Text="{Binding Value, Converter={StaticResource DurationSecondsToCompactStringConverter}, FallbackValue=0m}" Style="{StaticResource Dashboard.SummaryValue}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text=" " Style="{StaticResource Dashboard.SummaryDeltaText}" />
                <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Dashboard.SectionHeader" TargetType="{x:Type Grid}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Dashboard.SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.SectionToggleIcon" TargetType="{x:Type fa5:ImageAwesome}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.ChartFilter" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
    </Style>

    <Style x:Key="Dashboard.ContentTabControl" TargetType="{x:Type TabControl}" BasedOn="{StaticResource App.TabControl}" />

    <Style x:Key="Dashboard.ContentTabItem" TargetType="{x:Type TabItem}" BasedOn="{StaticResource App.TabItem}" />

    <Style x:Key="Dashboard.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Card}">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="Dashboard.MetricTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Dashboard.MetricLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.MetricValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.MetricValue.Death" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Dashboard.MetricValue}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
    </Style>

    <Style x:Key="Dashboard.CostLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.CostValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.EconomySummaryCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.SummaryCard}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
    </Style>

    <Style x:Key="Dashboard.EconomyDetailCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Card}">
        <Setter Property="MinHeight" Value="62" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
    </Style>

    <Style x:Key="Dashboard.SessionDeleteButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Style.Button.Base}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Red.7}" />
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.4}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SolidColorBrush.Button.Danger.Pressed}" />
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.1}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.7}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding CanDelete}" Value="True" />
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dashboard.ContentRankingCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Section}">
        <Setter Property="MinWidth" Value="350" />
    </Style>

    <Style x:Key="Dashboard.ContentRankingTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dashboard.ContentRankingName" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dashboard.ContentRankingValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.ContentRankingBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="5" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="TemplateRoot">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dashboard.ContentRankingTotalLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.ContentRankingTotalValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="Dashboard.ContentRankingItemTemplate" DataType="{x:Type models:DashboardContentRankingItem}">
        <Grid Height="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="21" />
                <RowDefinition Height="7" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Dashboard.ContentRankingName}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Value, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Dashboard.ContentRankingValue}" />
                <TextBlock Text=" (" Style="{StaticResource Dashboard.ContentRankingValue}" />
                <TextBlock Text="{Binding SharePercentage, StringFormat='{}{0:N1}%'}" Style="{StaticResource Dashboard.ContentRankingValue}" />
                <TextBlock Text=")" Style="{StaticResource Dashboard.ContentRankingValue}" />
            </StackPanel>
            <ProgressBar Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Value="{Binding BarPercentage, Mode=OneWay}"
                         Foreground="{Binding Brush}"
                         Style="{StaticResource Dashboard.ContentRankingBar}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dashboard.LootItemTemplate" DataType="{x:Type models:DashboardLootItem}">
        <Border MinHeight="52"
                Margin="0,0,0,5"
                Padding="6,4"
                Background="{StaticResource SolidColorBrush.Background.2}"
                BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="40"
                       Height="40"
                       Source="{Binding Item.Icon, IsAsync=True, Mode=OneWay}"
                       Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="7,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.LocalizedName}"
                               Foreground="{StaticResource SolidColorBrush.Text.2}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Item.LocalizedName}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowQuantity}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="x" Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="11" />
                            <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                       Foreground="{StaticResource SolidColorBrush.Text.4}"
                                       FontSize="11" />
                            <TextBlock Text="  |  " Foreground="{StaticResource SolidColorBrush.Text.5}" FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="{Binding LootedAtLocal, StringFormat='{}{0:g}'}"
                                   Foreground="{StaticResource SolidColorBrush.Text.4}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/silver.png" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding DisplayValue, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}"
                               Foreground="{StaticResource SolidColorBrush.Text.2}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Dashboard.LootAreaTemplate" DataType="{x:Type models:DashboardLootAreaItem}">
        <Border MinHeight="40"
                Margin="0,0,0,5"
                Padding="8,5"
                Background="{StaticResource SolidColorBrush.Background.2}"
                BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" VerticalAlignment="Center">
                    <Image Source="{Binding IconSource}" Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DungeonMode}" Value="{x:Static dungeon:DungeonMode.DragonArea}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <fa5:ImageAwesome Icon="Solid_Dungeon" Foreground="{StaticResource SolidColorBrush.Dungeon.Mode.DragonArea.1}">
                        <fa5:ImageAwesome.Style>
                            <Style TargetType="fa5:ImageAwesome">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DungeonMode}" Value="{x:Static dungeon:DungeonMode.DragonArea}">
