            <DataTrigger Binding="{Binding Tier}" Value="2">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.2}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tier}" Value="3">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.3}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tier}" Value="4">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.4}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tier}" Value="5">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.5}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tier}" Value="6">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.6}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tier}" Value="7">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.7}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tier}" Value="8">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.8}" />
            </DataTrigger>
        </Style.Triggers>
