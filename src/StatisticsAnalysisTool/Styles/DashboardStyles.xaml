    <DataTemplate x:Key="Dashboard.LootedChestContentTemplate" DataType="{x:Type models:DashboardLootedChestContentStatistics}">
        <Border MinHeight="150" Margin="5" Padding="12,9,12,8" Style="{StaticResource Dashboard.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="27" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="11" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Grid Width="22" Height="22" Margin="0,0,7,0">
                        <Image Source="{Binding ContentIconSource}" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContentType}" Value="{x:Static models:DashboardContentType.OpenWorld}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <fa5:ImageAwesome Icon="Solid_GlobeEurope"
                                          Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}">
                            <fa5:ImageAwesome.Style>
                                <Style TargetType="{x:Type fa5:ImageAwesome}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContentType}" Value="{x:Static models:DashboardContentType.OpenWorld}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fa5:ImageAwesome.Style>
                        </fa5:ImageAwesome>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Dashboard.LootedChestTitle}" />
                </DockPanel>

                <Grid Grid.Row="1"
                      Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="3,0,3,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalSummary.Value, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}"
                                   Style="{StaticResource Dashboard.LootedChestTotalValue}" />
                        <StackPanel DataContext="{Binding TotalSummary}" Orientation="Horizontal">
                            <TextBlock Text="{Binding ChangeIndicator}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                            <TextBlock Text=" " Style="{StaticResource Dashboard.SummaryDeltaText}" />
                            <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}"
                                       Style="{StaticResource Dashboard.SummaryDeltaText}" />
                            <TextBlock Text=" (" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                            <TextBlock Text="{Binding ChangePercentageText}" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                            <TextBlock Text=")" Style="{StaticResource Dashboard.SummaryDeltaText}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="8,3" Background="{StaticResource SolidColorBrush.Background.4}" />

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" ToolTip="{Binding TranslationOpenedStandardChests}">
                        <Grid Width="36" Height="36">
                            <Image Width="{Binding ChestIconSize}"
                                   Height="{Binding ChestIconSize}"
                                   Source="{Binding ChestIconSource}"
                                   Stretch="Uniform" />
                            <Image Width="36" Height="36" Source="/Assets/green_glow.png" Opacity="0.65" />
                        </Grid>
                        <TextBlock Text="{Binding Common, StringFormat='{}{0:N0}', FallbackValue=0}"
                                   Style="{StaticResource Dashboard.LootedChestRarityValue}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" ToolTip="{Binding TranslationOpenedUncommonChests}">
                        <Grid Width="36" Height="36">
                            <Image Width="{Binding ChestIconSize}"
                                   Height="{Binding ChestIconSize}"
                                   Source="{Binding ChestIconSource}"
                                   Stretch="Uniform" />
                            <Image Width="36" Height="36" Source="/Assets/blue_glow.png" Opacity="0.65" />
                        </Grid>
                        <TextBlock Text="{Binding Uncommon, StringFormat='{}{0:N0}', FallbackValue=0}"
                                   Style="{StaticResource Dashboard.LootedChestRarityValue}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" ToolTip="{Binding TranslationOpenedRareChests}">
                        <Grid Width="36" Height="36">
                            <Image Width="{Binding ChestIconSize}"
                                   Height="{Binding ChestIconSize}"
                                   Source="{Binding ChestIconSource}"
                                   Stretch="Uniform" />
                            <Image Width="36" Height="36" Source="/Assets/purple_glow.png" Opacity="0.65" />
                        </Grid>
                        <TextBlock Text="{Binding Rare, StringFormat='{}{0:N0}', FallbackValue=0}"
                                   Style="{StaticResource Dashboard.LootedChestRarityValue}" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" HorizontalAlignment="Center" ToolTip="{Binding TranslationOpenedLegendaryChests}">
                        <Grid Width="36" Height="36">
                            <Image Width="{Binding ChestIconSize}"
                                   Height="{Binding ChestIconSize}"
                                   Source="{Binding ChestIconSource}"
                                   Stretch="Uniform" />
                            <Image Width="36" Height="36" Source="/Assets/gold_glow.png" Opacity="0.65" />
                        </Grid>
                        <TextBlock Text="{Binding Legendary, StringFormat='{}{0:N0}', FallbackValue=0}" Style="{StaticResource Dashboard.LootedChestRarityValue}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Height="1" Margin="2,9,2,0" Background="{StaticResource SolidColorBrush.Background.4}" />

                <StackPanel Grid.Row="3" Margin="3,5,3,0" Orientation="Horizontal">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource SolidColorBrush.Text.2}" Text="{Binding TranslationAverage}" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource SolidColorBrush.Text.2}" Text=" / " />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource SolidColorBrush.Text.2}" Text="{Binding TranslationMaps}" />
                    <TextBlock Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}"
                               Text="{Binding AveragePerMap, StringFormat='{}{0:N2}', FallbackValue=0}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LootedChestsTemplate" DataType="{x:Type models:LootedChests}">
        <ItemsControl ItemsSource="{Binding ContentStatistics}" ItemTemplate="{StaticResource Dashboard.LootedChestContentTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>
    <Style x:Key="Dashboard.MobSummaryCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.CombatMetricCard}" />

    <Style x:Key="Dashboard.MobListItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dashboard.MobExpander" TargetType="{x:Type Expander}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Border Background="{StaticResource SolidColorBrush.Background.2}"
                            BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                            BorderThickness="1"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <ToggleButton DockPanel.Dock="Top" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Padding="10,0,10,0" Background="{TemplateBinding Background}">
                                            <Grid>
                                                <ContentPresenter Margin="0,0,38,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                                                <Border Width="28"
                                                        Height="28"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource SolidColorBrush.Background.3}"
                                                        CornerRadius="14">
                                                    <fa5:ImageAwesome x:Name="MobExpandIcon" Width="11" Height="11" Icon="Solid_ChevronDown" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MobExpandIcon" Property="Icon" Value="Solid_ChevronUp" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="MobExpandContent" Visibility="Collapsed" ContentSource="Content" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="MobExpandContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dashboard.MobHeaderMetricTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.3}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dashboard.MobHeaderMetricValue" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dashboard.MobTag" TargetType="{x:Type Border}">
