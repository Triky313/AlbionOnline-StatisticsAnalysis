    <DataTemplate x:Key="Dashboard.MobDetailValueTemplate">
        <Grid MinHeight="23">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                    BorderThickness="0,0,0,1" />
            <TextBlock Margin="0,2,8,3"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SolidColorBrush.Text.2}"
                       Text="{Binding Name}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Margin="8,2,0,3"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SolidColorBrush.Text.1}"
                       Text="{Binding Value}"
                       TextAlignment="Right" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>