            </DataTrigger>
            <DataTrigger Binding="{Binding MobTypeCategory}" Value="critter">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.MobType.Critter}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MobTypeCategory}" Value="environment">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.MobType.Environment}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MobTypeCategory}" Value="harmless">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.MobType.Harmless}" />
