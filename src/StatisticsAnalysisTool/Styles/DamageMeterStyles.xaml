<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:damageMeter="clr-namespace:StatisticsAnalysisTool.DamageMeter"
                    xmlns:enumerations="clr-namespace:StatisticsAnalysisTool.Enumerations">

    <!-- Damage meter statistics -->
    <Style x:Key="YourStats.SectionCard" TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="YourStats.MetricCard" TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="YourStats.Damage.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.MetricCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Damage.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.6}" />
    </Style>
    <Style x:Key="YourStats.Healing.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.MetricCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Healing.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Green.6}" />
    </Style>
    <Style x:Key="YourStats.Defense.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.MetricCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Defense.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.5}" />
    </Style>
    <Style x:Key="YourStats.Combat.MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.MetricCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Combat.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Yellow.5}" />
    </Style>
    <Style x:Key="YourStats.HeaderIcon" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style x:Key="YourStats.SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="YourStats.MetricLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.3}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="YourStats.MetricValue" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="TopStats.HighlightCard" TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DamageMeter.RankingCard" TargetType="{x:Type Border}">
        <Setter Property="MinWidth" Value="164" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Margin" Value="0,5,5,5" />
        <Setter Property="Padding" Value="9,8" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style x:Key="TopStats.HighlightIcon" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="23" />
    </Style>
    <Style x:Key="TopStats.HighlightTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TopStats.HighlightPlayer" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TopStats.HighlightValue" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="TopStats.RankingTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TopStats.RankingBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="YourStats.Damage.SectionCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.SectionCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Damage.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.6}" />
    </Style>

    <Style x:Key="YourStats.Healing.SectionCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.SectionCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Healing.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Green.6}" />
    </Style>

    <Style x:Key="YourStats.Defense.SectionCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.SectionCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Defense.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.5}" />
    </Style>

    <Style x:Key="YourStats.Combat.SectionCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.SectionCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Combat.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Yellow.5}" />
    </Style>

    <Style x:Key="YourStats.Damage.HeaderIcon" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.HeaderIcon}">
        <Setter Property="Background" Value="{StaticResource YourStats.Damage.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.6}" />
    </Style>

    <Style x:Key="YourStats.Healing.HeaderIcon" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.HeaderIcon}">
        <Setter Property="Background" Value="{StaticResource YourStats.Healing.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Green.6}" />
    </Style>

    <Style x:Key="YourStats.Defense.HeaderIcon" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.HeaderIcon}">
        <Setter Property="Background" Value="{StaticResource YourStats.Defense.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.5}" />
    </Style>

    <Style x:Key="YourStats.Combat.HeaderIcon" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.HeaderIcon}">
        <Setter Property="Background" Value="{StaticResource YourStats.Combat.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Yellow.5}" />
    </Style>

    <Style x:Key="YourStats.TopEntryCard" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="YourStats.Defense.TopEntryCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.TopEntryCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Defense.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.5}" />
    </Style>

    <Style x:Key="YourStats.Healing.TopEntryCard" TargetType="{x:Type Border}" BasedOn="{StaticResource YourStats.TopEntryCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Healing.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Green.6}" />
    </Style>

    <Style x:Key="YourStats.TopEntryRank" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="YourStats.TopEntryName" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="YourStats.TopEntryValue" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="TopStats.Damage.HighlightCard" TargetType="{x:Type Border}" BasedOn="{StaticResource TopStats.HighlightCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Damage.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.6}" />
    </Style>

    <Style x:Key="TopStats.Healing.HighlightCard" TargetType="{x:Type Border}" BasedOn="{StaticResource TopStats.HighlightCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Healing.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Green.6}" />
    </Style>

    <Style x:Key="TopStats.Defense.HighlightCard" TargetType="{x:Type Border}" BasedOn="{StaticResource TopStats.HighlightCard}">
        <Setter Property="Background" Value="{StaticResource YourStats.Defense.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.5}" />
    </Style>

    <Style x:Key="TopStats.Damage.HighlightIcon" TargetType="{x:Type Border}" BasedOn="{StaticResource TopStats.HighlightIcon}">
        <Setter Property="Background" Value="{StaticResource YourStats.Damage.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.6}" />
    </Style>

    <Style x:Key="TopStats.Healing.HighlightIcon" TargetType="{x:Type Border}" BasedOn="{StaticResource TopStats.HighlightIcon}">
        <Setter Property="Background" Value="{StaticResource YourStats.Healing.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Green.6}" />
    </Style>

    <Style x:Key="TopStats.Defense.HighlightIcon" TargetType="{x:Type Border}" BasedOn="{StaticResource TopStats.HighlightIcon}">
        <Setter Property="Background" Value="{StaticResource YourStats.Defense.MetricBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.5}" />
    </Style>

    <Style x:Key="TopStats.RankingIcon" TargetType="{x:Type fa5:ImageAwesome}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="TopStats.RankingGameIcon" TargetType="{x:Type iconPacks:PackIconGameIcons}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="TopStats.EntryRank" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TopStats.EntryName" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TopStats.EntryValue" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="TopStats.DamageSpellValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TopStats.EntryValue}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
    </Style>

    <Style x:Key="TopStats.DamageSpellShare" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TopStats.AbilityHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DamageMeter.TrackingStatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="Text" Value="{Binding Translation.TrackingIsNotActive, FallbackValue=TRACKING__IS__NOT__ACTIVE}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDamageMeterTrackingActive}" Value="True">
                <Setter Property="Text" Value="{Binding Translation.TrackingIsActive, FallbackValue=TRACKING__IS__ACTIVE}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DamageMeter.Live.PlayerList" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DamageMeterBindings.DamageMeterSortSelection.DamageMeterSortType}"
                         Value="{x:Static damageMeter:DamageMeterSortType.Mob}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DamageMeter.Live.MobList" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DamageMeterBindings.DamageMeterSortSelection.DamageMeterSortType}"
                         Value="{x:Static damageMeter:DamageMeterSortType.Mob}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DamageMeter.Snapshot.PlayerList" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DamageMeterBindings.DamageMeterSnapshotSortSelection.DamageMeterSortType}"
                         Value="{x:Static damageMeter:DamageMeterSortType.Mob}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DamageMeter.Snapshot.MobList" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DamageMeterBindings.DamageMeterSnapshotSortSelection.DamageMeterSortType}"
                         Value="{x:Static damageMeter:DamageMeterSortType.Mob}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DamageMeter.DescriptionIcon" TargetType="{x:Type Grid}">
        <Setter Property="Height" Value="16" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Margin" Value="0,3,10,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="DamageMeter.DescriptionText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Damage meter icon -->
    <Style x:Key="DamageMeter.ActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Style.Button.Neutral}">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="DamageMeter.ActionIcon" TargetType="{x:Type fa5:ImageAwesome}" BasedOn="{StaticResource Style.Button.Icon.White}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="DamageMeter.TextButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Style.Button.Neutral}">
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <Style x:Key="DamageMeter.DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Style.Button.Danger}">
        <Setter Property="MinWidth" Value="160" />
    </Style>

    <Style x:Key="DamageMeter.SettingCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="21" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Image" x:Key="DamageMeter.Icon">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Width" Value="40"/>
    </Style>

    <Style x:Key="DamageMeter.MobBadge" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Button.Border.Normal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="0,0,5,0" />
    </Style>

    <Style x:Key="DamageMeter.TierBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource DamageMeter.MobBadge}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static enumerations:Tier.T1}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.1}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static enumerations:Tier.T2}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.2}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static enumerations:Tier.T3}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.3}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static enumerations:Tier.T4}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.4}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static enumerations:Tier.T5}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.5}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static enumerations:Tier.T6}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.6}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static enumerations:Tier.T7}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.7}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static enumerations:Tier.T8}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Item.Tier.Color.8}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DamageMeter.MobRankBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource DamageMeter.MobBadge}">
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding MobRankCategory}" Value="{x:Static damageMeter:MobRankCategory.Elite}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MobRankCategory}" Value="{x:Static damageMeter:MobRankCategory.Boss}">
                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar" x:Key="DamageMeter.ProgressBar.Colors">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.UnknownWeaponType}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="sword">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Sword}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="spear">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Spear}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="quarterstaff">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Quarterstaff}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="shapeshifterstaff">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.ShapeShifterStaff}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="naturestaff">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.NatureStaff}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="mace">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Mace}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="holystaff">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.HolyStaff}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="hammer">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Hammer}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="froststaff">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.FrostStaff}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="firestaff">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.FireStaff}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="dagger">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Dagger}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="cursestaff">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.CursedStaff}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="knuckles">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Knuckles}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="crossbow">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Crossbow}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="bow">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Bow}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="axe">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.Axe}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShopSubCategory}" Value="arcanestaff">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Weapon.ArcaneStaff}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

