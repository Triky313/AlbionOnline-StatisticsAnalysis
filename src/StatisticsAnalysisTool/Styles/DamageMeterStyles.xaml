                         VerticalAlignment="Top" Background="{StaticResource SolidColorBrush.Transparent}" BorderThickness="0" Foreground="{StaticResource SolidColorBrush.Accent.Blue.Transparent.3}" HorizontalAlignment="Stretch" />
