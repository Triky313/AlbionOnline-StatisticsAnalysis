                <Grid ToolTip="{Binding UniqueName}">
                    <Grid.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowPlayers}" />
                    </Grid.InputBindings>
                    <Grid Margin="5,5,5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="225" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Width="100" Height="100" Source="{Binding AvatarSource}" Stretch="UniformToFill" Margin="-10,-20,0,0" />

                        <Grid Grid.Column="1" Margin="5,0,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Border Style="{StaticResource DamageMeter.TierBadge}" Tag="{Binding MobTier}">
                                    <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding MobTierString}" />
