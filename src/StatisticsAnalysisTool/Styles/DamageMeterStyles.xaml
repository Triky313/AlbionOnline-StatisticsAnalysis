                                <Border Style="{StaticResource DamageMeter.MobBadge}" MaxWidth="120">
                                    <TextBlock FontSize="12" Text="{Binding MobType}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Style="{StaticResource DamageMeter.MobRankBadge}">
                                    <TextBlock FontSize="12" Text="{Binding MobRank}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="2" Margin="0,0" VerticalAlignment="Center" ToolTip="{Binding TranslationFirstAttackTime}">
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding FirstAttackTimeLocal, StringFormat={}{0:g}}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Opacity="0.35" Text="{Binding TranslationFirstAttackTime}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="6,0" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Text="{Binding DamageShortString}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Opacity="0.65" Text="{Binding DamagePercentage, StringFormat={}{0:N2}%}" />
                        </StackPanel>

                        <TextBlock Grid.Column="4" Margin="6,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource SolidColorBrush.Accent.Green.4}" Text="{Binding DpsShortString, StringFormat={}{0}/dps}" />

                        <StackPanel Grid.Column="5" Margin="6,0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="{Binding TranslationCombatTime}">
                            <fa5:ImageAwesome Width="15" Height="15" Margin="0,0,7,0" Icon="Regular_Clock" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CombatTimeString}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" ToolTip="{Binding TranslationPlayers}">
                            <fa5:ImageAwesome Width="16" Height="16" Margin="0,0,7,0" Icon="Solid_Users" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="{Binding PlayerCount}" />
                        </StackPanel>

                        <Border Grid.Column="7" Margin="8,0,4,0" Padding="10,5" Background="{StaticResource SolidColorBrush.Accent.Blue.Transparent.5}"
                                CornerRadius="5" ToolTip="{Binding TranslationLocation}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding ContentTypeName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11" Opacity="0.72" Text="{Binding MapName}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Style="{StaticResource DamageMeter.TierBadge}" Tag="{Binding MapTier}">
                                    <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding MapTierString}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="8" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <fa5:ImageAwesome Foreground="{StaticResource SolidColorBrush.Text.1}">
                                <fa5:ImageAwesome.Style>
                                    <Style TargetType="{x:Type fa5:ImageAwesome}">
                                        <Setter Property="Icon" Value="Solid_ChevronDown" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlayersContainerVisibility}" Value="Visible">
                                                <Setter Property="Icon" Value="Solid_ChevronUp" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </fa5:ImageAwesome.Style>
                            </fa5:ImageAwesome>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border MinWidth="980" Margin="28,0,3,6" Padding="0,2,0,0"
                    BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.Transparent.5}"
                    BorderThickness="1,0,0,0" Visibility="{Binding PlayersContainerVisibility}">
                <ItemsControl ItemsSource="{Binding Players, IsAsync=True, Mode=OneWay}" ItemTemplate="{StaticResource DamageMeterFragmentTemplate}" />
            </Border>
        </StackPanel>
    </DataTemplate>

