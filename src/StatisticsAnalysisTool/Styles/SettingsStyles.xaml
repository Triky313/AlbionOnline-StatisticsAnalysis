<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Settings.Card" TargetType="{x:Type Border}" BasedOn="{StaticResource Dashboard.Section}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Settings.CardHeader" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="Settings.CardTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Dashboard.SectionTitle}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.3}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Settings.Field" TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Settings.FieldLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource App.FilterLabel}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Settings.ComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource App.FilterComboBox}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="Settings.TextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Settings.Button" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style x:Key="Settings.WarningText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Settings.DangerText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Settings.WarningText}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
    </Style>

    <Style x:Key="Settings.Footer" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="70" />
        <Setter Property="Padding" Value="10,20" />
        <Setter Property="Margin" Value="10,0,10,0" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
</ResourceDictionary>
